# Config Caddy pour nasap3d.com — géré par docker-compose.yml (service
# `caddy`, profil `full`), pas installé à la main sur l'hôte. Gère : URLs
# propres pour le front statique (réécriture interne, pas de redirection
# visible), + reverse proxy vers l'API (service Docker `api`, joignable par
# son nom sur le réseau interne du compose — jamais `localhost`, qui
# désignerait le conteneur Caddy lui-même).
#
# `/srv` = fichiers du front-end copiés dans l'image au build (voir
# Caddy.Dockerfile) — pas un montage du dépôt, donc server/, .git, .env* et
# docker-compose.yml n'y sont de toute façon jamais présents. Le blocage
# ci-dessous reste en défense en profondeur si jamais ça change.
#
# HTTPS automatique désactivé : géré ailleurs (autre outil déjà en place
# côté serveur) — Caddy sert ici en HTTP simple, pas de certificat Let's
# Encrypt demandé par ce conteneur.
{
	auto_https off
}

:80 {
	root * /srv
	encode gzip

	# Défense en profondeur — voir la note ci-dessus, ces chemins ne sont de
	# toute façon jamais copiés dans l'image.
	@blocked path /server/* /.git/* /.env* /docker-compose.yml /Caddyfile
	respond @blocked 404

	@home path /
	rewrite @home /Home.dc.html

	@services path /services
	rewrite @services /Services.dc.html

	@devis path /devis-instantane
	rewrite @devis "/Devis Instantane.dc.html"

	@machines path /machines
	rewrite @machines /Machines.dc.html

	@realisations path /realisations
	rewrite @realisations /Realisations.dc.html

	@apropos path /a-propos
	rewrite @apropos /About.dc.html

	@contact path /contact
	rewrite @contact /Contact.dc.html

	@panier path /panier
	rewrite @panier /Cart.dc.html

	@compte path /compte
	rewrite @compte /Account.dc.html

	@admin path /admin
	rewrite @admin /Admin.dc.html

	@cgu path /cgu
	rewrite @cgu /CGU.dc.html

	@confidentialite path /confidentialite
	rewrite @confidentialite /Confidentialite.dc.html

	@cookies path /cookies
	rewrite @cookies /Cookies.dc.html

	@mentionslegales path /mentions-legales
	rewrite @mentionslegales /MentionsLegales.dc.html

	@nantes path /impression-3d-nantes
	rewrite @nantes /Nantes.dc.html

	@cholet path /impression-3d-cholet
	rewrite @cholet /Cholet.dc.html

	@angers path /impression-3d-angers
	rewrite @angers /Angers.dc.html

	handle_errors {
		rewrite * /404.dc.html
		file_server
	}

	file_server
}
