{
  "name": "nasap3d-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "pdfkit": "^0.15.0",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
