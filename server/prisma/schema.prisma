generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  PRINTING
  READY
  DELIVERED
}

enum ShippingMode {
  PICKUP
  RELAY
  HOME
}

enum QuoteJobStatus {
  DRAFT
  ANALYZED
  EXPIRED
  CONVERTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  customerNo      String    @unique
  role            Role      @default(CLIENT)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  orders             Order[]
  invoices           Invoice[]
  quoteJobs          QuoteJob[]
  cartItems          CartItem[]
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  verificationCodes  VerificationCode[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum VerificationPurpose {
  SIGNUP
  EMAIL_CHANGE
  PASSWORD_CHANGE
}

// A 6-digit code rather than an emailed link (simpler UX: type the code
// instead of switching to the email app and clicking through) — shared by
// three flows: verifying a new account, confirming a new email address, and
// confirming a password change (see src/lib/verification.ts). `payload`
// carries whatever the confirm step needs to apply once the code checks out
// (the new email, or the new password's hash) — nothing sensitive lives
// here that isn't already what the change itself would store.
// codeHash is intentionally not unique — a coincidence between two users'
// codes is expected and harmless; verification is scoped by userId+purpose
// (the endpoint requires an active session) plus expiresAt/attempts.
//
// userId is nullable for purpose=SIGNUP only: that code is sent BEFORE the
// account exists (see src/lib/verification.ts createPendingSignupCode / src/
// routes/auth.ts) — payload carries the pending email+passwordHash, and the
// User row is only created once the code is confirmed. Cancelling the popup
// or letting the code expire simply leaves this row unconsumed; no account
// was ever created.
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  codeHash  String
  payload   String?
  attempts  Int                 @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

model Material {
  id              String          @id @default(cuid())
  key             String          @unique
  label           String
  densityGCm3     Float
  pricePerKgCents Int
  active          Boolean         @default(true)
  colors          MaterialColor[]
  quoteJobs       QuoteJob[]
}

model MaterialColor {
  id         String     @id @default(cuid())
  materialId String
  material   Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  colorName  String
  colorHex   String
  inStock    Boolean    @default(true)
  quoteJobs  QuoteJob[]

  @@unique([materialId, colorName])
}

model QualityProfile {
  id             String     @id @default(cuid())
  key            String     @unique
  label          String
  layerHeightMm  Float
  timeMultiplier Float
  active         Boolean    @default(true)
  quoteJobs      QuoteJob[]
}

model DiscountTier {
  id     String @id @default(cuid())
  minQty Int    @unique
  pct    Float
}

model Settings {
  id                  Int      @id @default(1)
  quoteEnabled        Boolean  @default(true)
  // Prix pièce = hourlyRateCents x temps d'impression (mesuré par le
  // slicer) + prix matière (poids x prix/kg du matériau) — pas de marge ni
  // de frais fixe séparés, voir PRICING.md. Réglable ici, en admin.
  hourlyRateCents     Int
  // Plancher de prix discret par pièce : un prix calculé en dessous
  // s'affiche directement à ce montant, sans ligne "frais minimum" visible.
  minUnitPriceCents   Int      @default(890)
  // Panier minimum : sous ce montant, smallOrderFeeCents s'ajoute au total
  // au lieu de bloquer la commande (le front affiche un message invitant à
  // ajouter des articles pour l'éviter) — appliqué au checkout (phase
  // Stripe), pas au devis lui-même.
  minOrderCents       Int      @default(1800)
  smallOrderFeeCents  Int      @default(500)
  updatedAt           DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model QuoteJob {
  id               String         @id @default(cuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  sessionId        String?
  fileKey          String
  // Set once an admin deletes the original upload from storage (see
  // POST /admin/orders/:orderId/items/:itemId/delete-file) to keep storage
  // from growing unbounded — fileKey is left in place as a historical
  // record even though it no longer resolves to a real object.
  fileDeletedAt    DateTime?
  fileName         String
  fileSizeBytes    Int
  materialId       String
  material         Material       @relation(fields: [materialId], references: [id])
  colorId          String
  color            MaterialColor  @relation(fields: [colorId], references: [id])
  qualityId        String
  quality          QualityProfile @relation(fields: [qualityId], references: [id])
  infillPct        Int
  quantity         Int
  volumeCm3        Float?
  bboxXMm          Float?
  bboxYMm          Float?
  bboxZMm          Float?
  weightG          Float?
  estimatedTimeMin Float?
  unitPriceCents   Int?
  totalPriceCents  Int?
  status           QuoteJobStatus @default(DRAFT)
  createdAt        DateTime       @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  sessionId  String?
  quoteJobId String
  quoteJob   QuoteJob @relation(fields: [quoteJobId], references: [id])
  qty        Int      @default(1)
  createdAt  DateTime @default(now())
  // Bumped by Prisma on every update (qty change) — the basis for "cart
  // inactive since" in the cleanup sweep (lib/cartCleanup.ts), not just
  // "added since".
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model Order {
  id                    String       @id @default(cuid())
  ref                   String       @unique
  userId                String
  user                  User         @relation(fields: [userId], references: [id])
  status                OrderStatus  @default(PENDING)
  subtotalCents         Int
  discountCents         Int
  shippingCents         Int          @default(0)
  totalCents            Int
  stripePaymentIntentId String?      @unique
  printingAt            DateTime?
  readyAt               DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Livraison (Boxtal) — tarif figé au moment du paiement (voir
  // server/src/lib/boxtal.ts), jamais recalculé après coup. relayPoint* est
  // nul pour une livraison à domicile (shippingMode = HOME).
  shippingMode        ShippingMode?
  shippingCarrierCode String?
  shippingServiceCode String?
  shippingLabel       String?
  shippingWeightG     Float?
  // Carton choisi au moment du paiement (voir PARCEL_BOXES_CM dans
  // boxtal.ts) — figé ici pour que l'achat d'étiquette (plus tard, par
  // l'admin) réutilise exactement le même carton que celui déjà facturé au
  // client, jamais recalculé. shippingOversized = la pièce ne rentrait dans
  // aucun des formats connus : le devis client est quand même parti avec le
  // plus grand carton (estimation raisonnable, le client n'est pas
  // impacté), mais l'achat d'étiquette est bloqué côté admin tant que ce
  // n'est pas vérifié/traité manuellement sur Boxtal.
  shippingParcelLengthCm Int?
  shippingParcelWidthCm  Int?
  shippingParcelHeightCm Int?
  shippingOversized      Boolean @default(false)
  recipientName       String?
  recipientPhone      String?
  recipientAddress    String?
  recipientCity       String?
  recipientZipcode    String?
  recipientCountry    String?
  relayPointCode      String?
  relayPointName      String?
  relayPointAddress   String?
  relayPointCity      String?
  relayPointZipcode   String?

  // Achat réel de l'étiquette d'expédition (voir purchaseShippingLabel()
  // dans boxtal.ts) — argent réel dépensé sur le compte Boxtal, déclenché
  // manuellement par l'admin. boxtalOrderRef non-nul = déjà acheté, sert de
  // garde-fou anti-double-achat.
  boxtalOrderRef   String?   @unique
  shippingLabelUrl String?
  labelPurchasedAt DateTime?
  // Transporteur (via Boxtal order_status "carrier_reference") ou saisi à la
  // main par l'admin quand l'étiquette a été achetée manuellement sur
  // Boxtal (hors gabarit, ou tout autre cas géré à la main). Gate le
  // passage au statut READY pour une commande expédiée (pas de retrait) —
  // voir routes/admin.ts. Purgé avec le reste du bloc expédition/
  // destinataire dès que la commande passe en DELIVERED (voir purgeShippingDataOnDelivery
  // dans routes/admin.ts) : plus aucune utilité passé ce point.
  trackingNumber String?

  items   OrderItem[]
  invoice Invoice?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteJobId         String?
  quoteJob           QuoteJob? @relation(fields: [quoteJobId], references: [id])
  nameSnapshot       String
  materialSnapshot   String
  colorNameSnapshot  String
  colorHexSnapshot   String
  infillSnapshot     Int
  qualitySnapshot    String
  qty                Int
  unitPriceCents     Int
  lineTotalCents     Int

  @@index([orderId])
}

model Invoice {
  id          String   @id @default(cuid())
  ref         String   @unique
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents Int
  pdfKey      String
  dailySeq    Int
  issuedAt    DateTime @default(now())

  @@index([userId])
}

model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  subject        String
  message        String
  fileKey        String?
  fileName       String?
  createdAt      DateTime @default(now())
}
