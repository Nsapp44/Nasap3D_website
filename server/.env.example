# Copy to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml's "db" service for local dev) ---
# En déploiement Docker (docker-compose.yml, profil "full"), cette valeur
# est IGNORÉE : le service "api" impose sa propre DATABASE_URL construite à
# partir de POSTGRES_PASSWORD (voir .env.example à la racine du dépôt) —
# celle-ci ne sert que pour `npm run dev` en dehors de Docker.
DATABASE_URL="postgresql://nasap3d:nasap3d_dev_only@localhost:5432/nasap3d"

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the static front-end)
CORS_ORIGIN="http://localhost:8080"
# Base URL of the static front-end, used to build links in emails (password reset, ...)
FRONT_URL="http://localhost:8080"
# This API's own public URL, used to build the admin contact-attachment
# download link in the contact notification email
API_BASE_URL="http://localhost:3000"
# Where contact-form submissions are notified
CONTACT_NOTIFY_EMAIL="contact@nasap3d.com"
# Where new-order notifications are sent (after Stripe payment confirms)
ORDER_NOTIFY_EMAIL="contact@nasap3d.com"

# --- Transactional email (account verification, password reset) — SMTP.
# Without these, emails are just logged to the console (see src/lib/mailer.ts).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER="noreply@nasap3d.com"
SMTP_PASSWORD=""
MAIL_FROM="Nasap3D <noreply@nasap3d.com>"

# --- Auth ---
# Argon2id parameters (memory in KiB). Raise on production hardware.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- hCaptcha --- see server/README.md for how to obtain these
# La clé "site key" (publique) N'EST PAS ICI : elle est codée en dur dans
# api-client.js (HCAPTCHA_SITE_KEY), lu par le front-end statique qui n'a
# aucun accès à ce .env — la changer ici ne fait rien. Seule la clé secrète
# ci-dessous est réellement lue par le serveur.
HCAPTCHA_SECRET_KEY=""

# --- Devis serveur (PrusaSlicer CLI) ---
# Chemin vers l'exécutable PrusaSlicer en ligne de commande.
#   Windows (dev)  : .../PrusaSlicer-x.y.z/prusa-slicer-console.exe
#   Linux (prod)   : /usr/local/bin/prusa-slicer — un wrapper installé par
#                    server/Dockerfile (voir server/README.md)
# En déploiement Docker, cette valeur est IGNORÉE elle aussi : docker-compose.yml
# impose /usr/local/bin/prusa-slicer au service "api" quoi qu'il arrive.
PRUSASLICER_BIN=""

# --- Livraison : Boxtal (agrégateur multi-transporteurs) --- see server/SHIPPING.md
# Vide = hôte de production (https://www.envoimoinscher.com/). Pour tester
# sans facturer le compte réel, avec des identifiants sandbox V1 :
# BOXTAL_BASE_URL="https://test.envoimoinscher.com/"
BOXTAL_BASE_URL=""
BOXTAL_API_KEY_V1=""
BOXTAL_API_SECRET_V1=""
BOXTAL_API_KEY_V3=""
BOXTAL_API_SECRET_V3=""
# Composant "carte" Boxtal (widget point relais, embarqué côté front au
# checkout) — les deux servent à obtenir un token temporaire côté serveur
# (POST https://api.boxtal.com/iam/account-app/token, Basic Auth), jamais
# envoyés tels quels au navigateur. Voir server/SHIPPING.md.
BOXTAL_MAP_API_KEY=""
BOXTAL_MAP_API_SECRET=""
# Adresse de départ des colis
BOXTAL_SHIPPER_COUNTRY="FR"
BOXTAL_SHIPPER_ZIPCODE=""
BOXTAL_SHIPPER_CITY=""
BOXTAL_SHIPPER_ADDRESS=""
# Only needed for a real label purchase (api/v1/order), not for rate quotes
BOXTAL_SHIPPER_FIRSTNAME=""
BOXTAL_SHIPPER_LASTNAME=""
BOXTAL_SHIPPER_COMPANY=""
BOXTAL_SHIPPER_EMAIL=""
BOXTAL_SHIPPER_PHONE=""

# --- Google Places (Avis Google badge, Home.dc.html) ---
# Restrict this key to the Places API only in Google Cloud Console, no
# HTTP-referer restriction (called server-side, never sent to the browser).
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- S3-compatible object storage (uploads + generated invoice PDFs) ---
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET="nasap3d"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true
