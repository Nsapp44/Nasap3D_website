# Copy to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml's "db" service for local dev) ---
DATABASE_URL="postgresql://nasap3d:nasap3d_dev_only@localhost:5432/nasap3d"

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the static front-end)
CORS_ORIGIN="http://localhost:8080"
# Base URL of the static front-end, used to build links in emails (password reset, ...)
FRONT_URL="http://localhost:8080"
# This API's own public URL, used to build the admin contact-attachment
# download link in the contact notification email
API_BASE_URL="http://localhost:3000"
# Where contact-form submissions are notified
CONTACT_NOTIFY_EMAIL="contact@nasap3d.com"
# Where new-order notifications are sent (after Stripe payment confirms)
ORDER_NOTIFY_EMAIL="contact@nasap3d.com"

# --- Transactional email (account verification, password reset) — SMTP.
# Without these, emails are just logged to the console (see src/lib/mailer.ts).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER="noreply@nasap3d.com"
SMTP_PASSWORD=""
MAIL_FROM="Nasap3D <noreply@nasap3d.com>"

# --- Auth ---
# Argon2id parameters (memory in KiB). Raise on production hardware.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- hCaptcha --- see server/README.md for how to obtain these
HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# --- Devis serveur (PrusaSlicer CLI) ---
# Chemin vers l'exécutable PrusaSlicer en ligne de commande.
#   Windows (dev)  : .../PrusaSlicer-x.y.z/prusa-slicer-console.exe
#   Linux (prod)   : /usr/local/bin/prusa-slicer (compilé via server/docker/prusaslicer — voir README)
PRUSASLICER_BIN=""

# --- Livraison : Boxtal (agrégateur multi-transporteurs) --- see server/SHIPPING.md
BOXTAL_API_KEY_V1=""
BOXTAL_API_SECRET_V1=""
BOXTAL_API_KEY_V3=""
BOXTAL_API_SECRET_V3=""
# Composant "carte" Boxtal (widget point relais, embarqué côté front au checkout)
BOXTAL_MAP_API_KEY=""
BOXTAL_MAP_API_SECRET=""
# Adresse de départ des colis
BOXTAL_SHIPPER_COUNTRY="FR"
BOXTAL_SHIPPER_ZIPCODE=""
BOXTAL_SHIPPER_CITY=""
BOXTAL_SHIPPER_ADDRESS=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- S3-compatible object storage (uploads + generated invoice PDFs) ---
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET="nasap3d"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true
