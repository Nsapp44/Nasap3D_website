# Copy to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml's "db" service for local dev) ---
DATABASE_URL="postgresql://nasap3d:nasap3d_dev_only@localhost:5432/nasap3d"

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the static front-end)
CORS_ORIGIN="http://localhost:8080"

# --- Auth ---
# Random 32+ byte secrets used to hash session/refresh tokens before storage.
# Generate with: openssl rand -base64 48
SESSION_COOKIE_SECRET="change-me"
REFRESH_TOKEN_PEPPER="change-me"
# Argon2id parameters (memory in KiB). Raise on production hardware.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- reCAPTCHA (Google) ---
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- S3-compatible object storage (uploads + generated invoice PDFs) ---
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET="nasap3d"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true
