---
// Page indexable : maquettiste à Nantes. Portage de docs/maquettes/page-maquettiste-nantes_2026-11-08.html.
// Cible « maquettiste Nantes / maquettage / maquette sur mesure ». Page sœur : /maquette-industrielle.
import BaseLayout from "../layouts/BaseLayout.astro";
import MachinesStrip from "../components/MachinesStrip.astro";
import StoryboardCellule from "../components/StoryboardCellule.astro";
import IconSprite from "../components/maquettiste/IconSprite.astro";
import HeroMaquettiste from "../components/maquettiste/HeroMaquettiste.astro";
import SecInteractive from "../components/maquettiste/SecInteractive.astro";
import SecBureauEtudes from "../components/maquettiste/SecBureauEtudes.astro";
import SecPourQui from "../components/maquettiste/SecPourQui.astro";
import SecProcess from "../components/maquettiste/SecProcess.astro";
import SecTypes from "../components/maquettiste/SecTypes.astro";
import SecBeyond from "../components/maquettiste/SecBeyond.astro";
import SecDistinction from "../components/maquettiste/SecDistinction.astro";
import ProjectsCarousel from "../components/maquettiste/ProjectsCarousel.astro";
import SecFaq from "../components/maquettiste/SecFaq.astro";
import FinalCta from "../components/maquettiste/FinalCta.astro";
import MobileCta from "../components/maquettiste/MobileCta.astro";
import PageMotion from "../components/maquettiste/PageMotion.astro";
import { MAQUETTISTE_FAQ } from "../data/maquettiste-faq";
import "../styles/maquettiste-nantes.css";

const siteUrl = "https://nasap3d.com";
const offerTypes = [
  { name: "Maquette d'architecture", description: "Bâtiments, quartiers et aménagements à l'échelle, pour concours, promotion et présentation client." },
  { name: "Maquette industrielle, commerciale et de salon", description: "Machines, équipements, procédés et stands reproduits avec LED et pièces mobiles, démontables et transportables, pour démonstration, salon et présentation client." },
  { name: "Maquette pédagogique et scientifique", description: "Modèles en coupe et maquettes scientifiques pour laboratoires, écoles et médiation." },
  { name: "Maquette de design produit", description: "Prototype d'aspect ou maquette de gamme pour valider une forme, une couleur, une ergonomie avant l'industrialisation." },
  { name: "Prototypes et objets sur mesure pour marques", description: "Prototypes fonctionnels ou d'aspect, objets et petits produits pour exposition, marketing et retail, petites séries à partir d'une maquette validée." },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Maquettiste à Nantes : maquettes industrielles, d'architecture et de présentation",
      description:
        "Atelier de maquettiste à Nantes : idéation, conception, modélisation 3D et fabrication de maquettes sur mesure (industrielles, architecture, salon, pédagogiques, design produit), avec intégration électronique (écrans, LED), éléments interactifs et pièces mobiles. Livraison en France et à l'international.",
      serviceType: "Maquettiste, maquettes sur mesure",
      url: `${siteUrl}/maquettiste-nantes`,
      inLanguage: "fr-FR",
      provider: { "@id": `${siteUrl}/#business` },
      areaServed: [
        { "@type": "City", name: "Nantes" },
        { "@type": "Country", name: "France" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Types de maquettes",
        itemListElement: offerTypes.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.name, description: o.description },
        })),
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: MAQUETTISTE_FAQ.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Maquettes", item: `${siteUrl}/maquettiste-nantes` },
      ],
    },
  ],
};
---

<BaseLayout
  title="Maquettiste à Nantes : conception et fabrication | Nasap3D"
  description="Bureau d'études et maquettiste à Nantes : idéation, modélisation 3D, fabrication. Maquettes industrielles, de salon, interactives (écrans, LED)."
  path="/maquettiste-nantes"
>
  <Fragment slot="head">
    <meta name="color-scheme" content="dark" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <IconSprite />
  <main class="mqn">
    <HeroMaquettiste />
    <div class="rideau">
      <StoryboardCellule />
      <SecInteractive />
      <SecBureauEtudes />
      <SecPourQui />
      <SecProcess />
      <SecTypes />
      <SecBeyond />
      <SecDistinction />
      <ProjectsCarousel />
      <div class="wrap"><MachinesStrip /></div>
      <SecFaq />
      <FinalCta />
    </div>
  </main>
  <MobileCta />
  <PageMotion />
</BaseLayout>
