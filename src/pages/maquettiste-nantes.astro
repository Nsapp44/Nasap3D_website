---
// Page indexable : maquettiste à Nantes (maquettes industrielles, d'architecture, de présentation).
// Cible « maquettiste Nantes / maquettage / maquette sur mesure ». Page sœur : /maquette-industrielle.
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion";
import MaquetteCarousel from "../components/MaquetteCarousel.astro";
import MachinesStrip from "../components/MachinesStrip.astro";
import { MAQUETTES_ACTIVES } from "../data/maquettes";

const types = [
  { title: "Maquette d'architecture", text: "Bâtiment, quartier ou aménagement intérieur, à l'échelle de votre choix, pour un concours, une promotion immobilière ou une présentation client." },
  { title: "Maquette industrielle, commerciale et de salon", href: "/maquette-industrielle", text: "Machine, équipement, procédé (filtration, bioréacteur), stand, produit ou gamme reproduit fidèlement, avec LED et pièces mobiles si besoin, démontable et facile à transporter, pour une démonstration, un appel d'offres, un salon ou une présentation client." },
  { title: "Maquette pédagogique et scientifique", text: "Modèle en coupe, multicolore et peint, pour expliquer une cellule, un mécanisme ou un procédé en laboratoire, en école ou en médiation scientifique." },
  { title: "Maquette de design produit", text: "Prototype d'aspect ou maquette de gamme pour valider une forme, une couleur, une ergonomie avant l'industrialisation." },
];

const audiences = [
  { title: "Bureaux d'études et designers produit", text: "Valider une forme, un encombrement ou un principe avant de lancer la fabrication." },
  { title: "Industriels", text: "Présenter une machine ou un procédé trop gros, trop cher ou trop sensible à déplacer." },
  { title: "Architectes et promoteurs", text: "Rendre un projet lisible pour un jury, une collectivité ou des acquéreurs." },
  { title: "Équipes commerciales et exposants", text: "Un objet qui attire l'œil sur le stand, appuie la vente et se transporte sans souci." },
  { title: "Laboratoires, écoles et médiation scientifique", text: "Des modèles pédagogiques qui rendent un phénomène ou un appareil compréhensible d'un coup d'œil." },
  { title: "Porteurs de projet et start-up", text: "Passer de l'idée à un objet que l'on montre à un investisseur, un partenaire ou un client." },
];

const strengths = [
  { title: "Un atelier réel à Nantes", text: "Modélisation, fabrication et finitions sont faites sur place, au quartier Canclaux. Vous pouvez passer voir le travail." },
  { title: "LED et pièces mobiles", text: "Chenille lumineuse, électronique intégrée, éléments qui bougent : la maquette se démontre, elle ne reste pas figée." },
  { title: "Visible en 360° en ligne", text: "Vos clients font tourner la maquette sur écran avant même de la voir en vrai." },
  { title: "Expertise avant paiement", text: "Nous étudions la faisabilité de votre projet gratuitement. Vous ne payez qu'une fois la commande acceptée." },
  { title: "Réactivité et urgences", text: "Nous répondons vite et nous savons prendre une demande urgente : dites-nous l'échéance dès le premier message." },
  { title: "Confidentialité", text: "Vos plans et projets restent chez nous. Nous signons un accord de confidentialité si vous le demandez." },
];

const cases = [
  { title: "Cellule biologique avec animation LED", text: "Modèle pédagogique en coupe pour la médiation scientifique : coque imprimée puis peinte à la main, nombreuses petites pièces assemblées une à une, électronique et chenille LED intégrées." },
  { title: "Système de filtration et de purification", text: "Maquette d'un équipement de procédé pour le secteur biotechnologique : châssis imprimé, vraie tuyauterie transparente, roulettes et presse-étoupes en métal pour un rendu crédible." },
  { title: "Caravane de présentation", text: "Maquette de vitrine pour le secteur du loisir : carrosserie imprimée en plusieurs couleurs dans la masse, vitres et feux en plexiglas découpé, finitions soignées." },
];

const steps = [
  { n: "1", title: "Vous décrivez le projet", text: "Plans, fichier 3D, photos ou simple idée : tout point de départ convient." },
  { n: "2", title: "Idéation et modélisation 3D", text: "Pas de fichier ? Nous imaginons et modélisons la maquette avec vous, à partir de vos éléments." },
  { n: "3", title: "Étude de faisabilité gratuite", text: "Nous examinons votre projet et vous répondons avant tout paiement. Pas de paiement à la commande." },
  { n: "4", title: "Fabrication, finitions, livraison", text: "Réalisée dans notre atelier à Nantes, puis retrait sur place ou livraison partout en France." },
];

const gallery = [
  { img: "/assets/real-1.webp", label: "Maquette de système de filtration" },
  { img: "/assets/real-19.webp", label: "Maquette de bioréacteur" },
  { img: "/assets/real-21.webp", label: "Détail vannes et manomètres du bioréacteur" },
  { img: "/assets/real-8.webp", label: "Maquette de cellule en coupe" },
  { img: "/assets/real-17.webp", label: "Maquettes de design produit" },
  { img: "/assets/real-2.webp", label: "Panneau fluidique à l'échelle" },
];

const faqs = [
  { q: "Pouvez-vous nous aider à concevoir la maquette à partir d'une simple idée ?", a: "Oui. Nous menons l'idéation et la conception avec vous : ce que la maquette doit montrer, l'échelle, les parties mobiles ou lumineuses, puis nous la modélisons en 3D et la fabriquons dans notre atelier à Nantes. L'étude de faisabilité est gratuite, avant tout paiement." },
  { q: "Êtes-vous un maquettiste ou un service d'impression 3D ?", a: "Un maquettiste : l'impression 3D est l'un de nos outils, à côté de la découpe, du ponçage, de la peinture et de l'électronique. Notre métier, c'est la conception de la maquette (modélisation 3D, design produit, choix des finitions) jusqu'à sa livraison." },
  { q: "Réalisez-vous des maquettes d'architecture, industrielles, commerciales, de design produit, pédagogiques ou scientifiques ?", a: "Oui : maquette d'architecture, maquette industrielle, commerciale et de salon (démonstration, présentation client), maquette de design produit, maquette pédagogique et scientifique. Chaque maquette est conçue sur mesure à partir de vos plans, fichiers, photos ou d'une simple idée." },
  { q: "Quels matériaux et quelles finitions pour une maquette ?", a: "Nous choisissons la matière selon l'usage de la maquette (présentation, manipulation, démonstration). Ponçage, apprêt et peinture sont possibles selon le rendu attendu ; décrivez votre projet et nous vous conseillons pendant l'étude de faisabilité." },
  { q: "Quelle échelle et quelles dimensions maximales ?", a: "L'échelle se choisit librement selon votre projet. Une pièce unique est limitée par le volume de nos machines ; au-delà, la maquette est découpée en plusieurs parties puis assemblée. Nous confirmons la faisabilité avant tout paiement." },
  { q: "Faut-il un fichier 3D pour commander une maquette ?", a: "Non. Avec des plans, des photos, des cotes ou même une simple description, nous pouvons modéliser la maquette nous-mêmes avant de la fabriquer." },
  { q: "Quels sont les délais ?", a: "Les délais vont d'une semaine à un mois selon le projet. Nous sommes très réactifs et les urgences sont possibles : chaque projet est sur devis sur mesure, demandez-nous le vôtre en précisant votre échéance." },
  { q: "Peut-on avoir une maquette peinte ou multicolore ?", a: "Oui. Une maquette peut être imprimée en plusieurs couleurs ou peinte après impression, par exemple pour distinguer les parties d'un modèle pédagogique." },
  { q: "Livrez-vous les maquettes hors de Nantes ?", a: "Oui, partout en France. Vous pouvez aussi retirer votre maquette à Nantes (Canclaux). Chaque commande est d'abord étudiée par notre équipe ; vous ne payez qu'une fois la commande acceptée." },
  { q: "Mon projet est confidentiel : signez-vous un accord de confidentialité ?", a: "Oui, sur demande nous signons un accord de confidentialité (NDA) avant que vous nous transmettiez plans et fichiers. Vos documents ne sont utilisés que pour votre maquette." },
  { q: "La maquette peut-elle être démontable et transportable pour un salon ?", a: "Oui. Nous pouvons concevoir la maquette en plusieurs modules démontables, avec un emballage adapté, pour qu'elle voyage et se remonte facilement sur votre stand. Précisez-le dans votre demande." },
  { q: "Combien coûte une maquette sur mesure ?", a: "Chaque maquette est unique : le devis est sur mesure et gratuit, après étude de votre projet. Nous n'affichons pas de tarif public, car il dépend de la taille, du niveau de détail et des options (LED, pièces mobiles, finitions). Décrivez votre besoin, nous vous répondons rapidement." },
];

const siteUrl = "https://nasap3d.com";
const offerTypes = [
  { name: "Maquette d'architecture", description: "Bâtiments, quartiers et aménagements à l'échelle, pour concours, promotion et présentation client." },
  { name: "Maquette industrielle, commerciale et de salon", description: "Machines, équipements, procédés, stands et produits reproduits avec LED et pièces mobiles, démontables et transportables, pour démonstration, salon et présentation client." },
  { name: "Maquette pédagogique et scientifique", description: "Modèles en coupe et maquettes scientifiques pour laboratoires, écoles et médiation." },
  { name: "Maquette de design produit", description: "Prototype d'aspect ou maquette de gamme pour valider une forme, une couleur, une ergonomie avant l'industrialisation." },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Maquettiste à Nantes : maquettes industrielles, d'architecture et de présentation",
      description:
        "Idéation, conception, modélisation 3D, atelier de maquettiste à Nantes : conception et fabrication de maquettes sur mesure (industrielles, architecture, salon, pédagogiques), avec LED et pièces mobiles. Étude de faisabilité gratuite avant tout paiement, livraison en France.",
      serviceType: "Maquettiste, maquettes sur mesure",
      url: `${siteUrl}/maquettiste-nantes`,
      inLanguage: "fr-FR",
      provider: { "@id": `${siteUrl}/#business` },
      areaServed: [
        { "@type": "City", name: "Nantes" },
        { "@type": "Country", name: "France" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Types de maquettes",
        itemListElement: offerTypes.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.name, description: o.description },
        })),
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Maquettes", item: `${siteUrl}/maquettiste-nantes` },
      ],
    },
  ],
};
---

<BaseLayout
  title="Maquettiste à Nantes : conception et fabrication | Nasap3D"
  description="Maquettiste à Nantes : idéation, modélisation 3D, fabrication. Maquettes industrielles, architecture, commerciales, pédagogiques. Expertise gratuite."
  path="/maquettiste-nantes"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="lp-hero">
    <h1 class="lp-title">Maquettiste à Nantes : maquettes industrielles, d'architecture et de présentation</h1>
    <p class="lp-subtitle">Notre atelier de Nantes conçoit et fabrique des maquettes sur mesure : idéation, conception, modélisation 3D, puis fabrication (impression 3D, ponçage, peinture), LED et pièces mobiles. Une maquette fidèle à votre projet, étudiée gratuitement avant tout paiement et livrée partout en France. Un maquettage réactif, adapté à vos échéances, urgences comprises.</p>
    <div class="lp-ctas">
      <a href="/contact" class="lp-btn lp-btn-primary"><span class="lp-btn-label">Demander un devis sur mesure <span class="lp-arrow" aria-hidden="true">→</span></span></a>
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Pour qui travaille notre atelier de maquettes</h2>
    <div class="lp-steps">
      {
        audiences.map((a, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{a.title}</h3>
            <p class="lp-step-text">{a.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">De l'idée à la maquette : idéation, conception, modélisation 3D, fabrication</h2>
    <p class="lp-note">Un maquettiste ne se contente pas de reproduire : il aide à donner forme à une idée. Nous partons de votre besoin (convaincre un jury, présenter une machine, expliquer un phénomène) et nous menons l'idéation avec vous : ce que la maquette doit montrer, à quelle échelle, ce qui doit s'allumer ou bouger. Vient ensuite la conception : découpe en pièces, assemblage, démontage pour le transport.</p>
    <p class="lp-note">La modélisation 3D est faite dans notre atelier à partir de vos plans, photos ou croquis. C'est aussi là qu'intervient notre regard de design produit, sur les proportions, les couleurs et la lisibilité. La fabrication combine plusieurs outils (impression 3D, découpe, ponçage, peinture, électronique) selon le rendu voulu : maquette d'architecture, <a href="/maquette-industrielle">maquette industrielle sur mesure</a>, maquette commerciale, pédagogique ou scientifique. Chaque projet passe d'abord par une étude de faisabilité gratuite, avant tout paiement.</p>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Quatre types de maquettes sur mesure</h2>
    <div class="lp-steps">
      {
        types.map((t, i) =>
          t.href ? (
            <a class="lp-step lp-step-link" href={t.href} style={`--i:${i}`}>
              <h3 class="lp-step-title">{t.title} <span class="lp-arrow" aria-hidden="true">→</span></h3>
              <p class="lp-step-text">{t.text}</p>
            </a>
          ) : (
            <div class="lp-step" style={`--i:${i}`}>
              <h3 class="lp-step-title">{t.title}</h3>
              <p class="lp-step-text">{t.text}</p>
            </div>
          )
        )
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Ce qui distingue notre maquettiste</h2>
    <div class="lp-steps">
      {
        strengths.map((s, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{s.title}</h3>
            <p class="lp-step-text">{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Réaliser votre maquette : comment ça se passe</h2>
    <div class="lp-steps">
      {
        steps.map((s, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <div class="lp-step-n">{s.n}</div>
            <h3 class="lp-step-title">{s.title}</h3>
            <p class="lp-step-text">{s.text}</p>
          </div>
        ))
      }
    </div>
    <p class="lp-note">Tout est sur devis sur mesure, gratuit. Nous sommes très réactifs et les urgences sont possibles : indiquez-nous votre échéance.</p>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Maquettes réalisées : trois cas concrets</h2>
    <div class="lp-steps">
      {
        cases.map((c, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{c.title}</h3>
            <p class="lp-step-text">{c.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Nos maquettes</h2>
    <div class="lp-real-grid">
      {
        gallery.map((r, i) => (
          <figure class="lp-real" style={`--i:${i}`}>
            <img src={r.img} alt={r.label} loading="lazy" decoding="async" width="600" height="750" />
            <figcaption>
              <strong>{r.label}</strong>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {
    MAQUETTES_ACTIVES.length > 0 && (
      <section class="lp-section" data-rv>
        <h2 class="lp-h2">Explorez nos maquettes en 3D</h2>
        <MaquetteCarousel />
      </section>
    )
  }

  <section class="lp-section" data-rv>
    <MachinesStrip />
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Questions fréquentes</h2>
    <FaqAccordion items={faqs} client:visible />
  </section>

  <section class="lp-section lp-final" data-rv>
    <h2 class="lp-h2">Un projet de maquette ?</h2>
    <p class="lp-note lp-final-note">Décrivez-nous votre besoin et votre échéance : nous étudions la faisabilité gratuitement, avant tout paiement.</p>
    <div class="lp-ctas">
      <a href="/contact" class="lp-btn lp-btn-primary"><span class="lp-btn-label">Demander un devis sur mesure <span class="lp-arrow" aria-hidden="true">→</span></span></a>
    </div>
  </section>
</BaseLayout>


<script>
  // Apparition douce au défilement. Sans JS ou avec « réduire les animations », tout reste visible.
  const items = document.querySelectorAll<HTMLElement>("[data-rv]");
  if (items.length && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("lp-motion");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0, rootMargin: "0px 0px 700px 0px" },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  .lp-hero,
  .lp-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .lp-hero {
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .lp-section {
    padding-bottom: 44px;
  }
  .lp-title {
    font: 700 32px/1.15 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 14px;
  }
  .lp-subtitle {
    font: 400 15px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 24px;
  }
  .lp-ctas {
    display: flex;
    gap: 12px;
  }
  .lp-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    font: 600 14px/1.35 "Inter", sans-serif;
    padding: 14px 18px;
    border-radius: 8px;
  }
  .lp-btn-secondary {
    border: 1px solid rgba(255, 90, 60, 0.6);
    background: rgba(255, 90, 60, 0.08);
    color: #f3f1ec;
  }
  .lp-h2 {
    font: 700 20px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 16px;
  }
  .lp-steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  /* Nombre impair de cartes : la dernière prend toute la ligne (pas de carte orpheline). */
  .lp-steps > :last-child:nth-child(odd) { grid-column: 1 / -1; }
  .lp-step {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 18px;
    background: #1a1917;
  }
  .lp-step-n {
    font: 700 18px "Space Grotesk", sans-serif;
    color: #ff5a3c;
    margin-bottom: 6px;
  }
  .lp-step-title {
    font: 600 14px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 6px;
  }
  .lp-step-text {
    font: 400 12px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }
  .lp-real-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .lp-real {
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    background: #1a1917;
  }
  .lp-real img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    background: #201d1b;
  }
  .lp-real figcaption {
    padding: 12px 14px;
    font: 400 12px/1.5 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
  }
  .lp-real strong {
    display: block;
    color: #f3f1ec;
    font: 600 13px "Space Grotesk", sans-serif;
  }
  .lp-final {
    border: 1px solid rgba(255, 90, 60, 0.3);
    background: rgba(255, 90, 60, 0.08);
    border-radius: 12px;
    padding: 28px 24px;
    margin-bottom: 44px;
  }

  /* Motion : entrée du hero au chargement, apparition au défilement, survols. */
  @keyframes lpFadeUp {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .lp-title { animation: lpFadeUp .5s .05s ease both; }
  .lp-subtitle { animation: lpFadeUp .5s .15s ease both; }
  .lp-hero .lp-btn-primary { animation: lpFadeUp .5s .25s ease both; }
  .lp-hero .lp-btn-secondary { animation: lpFadeUp .5s .35s ease both; }

  :global(.lp-motion) [data-rv] {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity .5s ease, transform .5s ease;
  }
  :global(.lp-motion) [data-rv].is-in {
    opacity: 1;
    transform: none;
  }
  :global(.lp-motion) .lp-step,
  :global(.lp-motion) .lp-real {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity .5s ease, transform .5s ease, border-color .25s ease, box-shadow .25s ease, scale .25s ease;
    transition-delay: calc(var(--i, 0) * 90ms + 100ms), calc(var(--i, 0) * 90ms + 100ms), 0s, 0s, 0s;
  }
  :global(.lp-motion) [data-rv].is-in .lp-step,
  :global(.lp-motion) [data-rv].is-in .lp-real {
    opacity: 1;
    transform: none;
  }

  .lp-btn {
    transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .lp-btn:hover {
    transform: translateY(-2px);
  }
  .lp-btn:active {
    transform: translateY(0);
  }
  .lp-btn-secondary:hover {
    border-color: #ff5a3c;
    background: rgba(255, 90, 60, 0.16);
  }
  .lp-step:hover,
  .lp-real:hover {
    border-color: rgba(255, 90, 60, 0.45);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }
  /* Même survol que les cartes machines : carte +2 % (propriété scale, indépendante du transform d'entrée), photo +5 %. */
  .lp-real {
    transition: scale .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .lp-real:hover {
