---
// Page indexable : maquettiste à Nantes (maquettes industrielles, d'architecture, de présentation).
// Cible « maquettiste Nantes / maquettage / maquette sur mesure ». Page sœur : /maquette-industrielle.
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion";
import MaquetteCarousel from "../components/MaquetteCarousel.astro";
import MachinesStrip from "../components/MachinesStrip.astro";
import StoryboardCellule from "../components/StoryboardCellule.astro";
import { MAQUETTES_ACTIVES } from "../data/maquettes";

const types = [
  { title: "Maquette d'architecture", text: "Bâtiment, quartier ou aménagement intérieur, à l'échelle de votre choix, pour un concours, une promotion immobilière ou une présentation client." },
  { title: "Maquette industrielle, commerciale et de salon", href: "/maquette-industrielle", text: "Machine, équipement, procédé (filtration, bioréacteur), stand ou produit reproduit fidèlement, avec électronique intégrée (écrans, LED), éléments interactifs et pièces mobiles si besoin, démontable et facile à transporter, pour une démonstration, un appel d'offres, un salon ou une présentation client." },
  { title: "Maquette pédagogique et scientifique", text: "Modèle en coupe, multicolore et peint, pour expliquer une cellule, un mécanisme ou un procédé en laboratoire, en école ou en médiation scientifique." },
  { title: "Maquette de design produit", text: "Prototype d'aspect ou maquette de gamme pour valider une forme, une couleur, une ergonomie avant l'industrialisation." },
];

const audiences = [
  { title: "Bureaux d'études et designers produit", text: "Valider une forme, un encombrement ou un principe avant de lancer la fabrication." },
  { title: "Industriels", text: "Présenter une machine ou un procédé trop gros, trop cher ou trop sensible à déplacer." },
  { title: "Architectes et promoteurs", text: "Rendre un projet lisible pour un jury, une collectivité ou des acquéreurs." },
  { title: "Équipes commerciales et exposants", text: "Un objet qui attire l'œil sur le stand, appuie la vente et se transporte sans souci." },
  { title: "Laboratoires, écoles et médiation scientifique", text: "Des modèles pédagogiques qui rendent un phénomène ou un appareil compréhensible d'un coup d'œil." },
  { title: "Porteurs de projet et start-up", text: "Passer de l'idée à un objet que l'on montre à un investisseur, un partenaire ou un client." },
];

const strengths = [
  { title: "Un atelier réel à Nantes", text: "Modélisation, fabrication et finitions sont faites sur place, au quartier Canclaux. Vous pouvez passer voir le travail." },
  { title: "Maquettes interactives et électronique intégrée", text: "Écrans, LED, chenille lumineuse, éléments qui bougent : nous intégrons l'électronique pour une maquette interactive, qui se manipule et se démontre." },
  { title: "Visible en 360° en ligne", text: "Vos clients font tourner la maquette sur écran avant même de la voir en vrai." },
  { title: "Réactivité", text: "Nous savons prendre une demande en charge rapidement et répondre vite, urgences comprises : indiquez-nous l'échéance dès le premier message." },
  { title: "Un regard de bureau d'études et de design produit", text: "Nous rendons faisable une idée qui existe déjà, ou nous partons d'une simple idée sans dessin pour la concevoir avec vous, de l'idéation à la fabrication." },
  { title: "Confidentialité", text: "Vos plans et projets restent chez nous. Nous signons un accord de confidentialité si vous le demandez." },
];

const beyond = [
  { title: "Prototype fonctionnel ou d'aspect", text: "Un objet pour tester une forme, un mécanisme ou un usage, ou pour montrer le rendu final avant l'industrialisation." },
  { title: "Objets et petits produits pour marques", text: "Exposition, PLV, événementiel, présentation marketing, édition limitée : des objets conçus et fabriqués sur mesure pour porter votre image." },
  { title: "De la maquette à la petite série", text: "Une maquette validée peut devenir une petite série fabriquée dans notre atelier. Découvrez nos <a href=\"/services\">services de fabrication</a>." },
];

const steps = [
  { n: "1", title: "Vous décrivez le projet", text: "Plans, fichier 3D, photos, croquis ou simple idée : tout point de départ convient. Dites-nous aussi à qui la maquette est destinée et pour quand." },
  { n: "2", title: "Étude de faisabilité", text: "Nous étudions votre projet et vous disons ce qui est faisable, à quelle échelle et avec quelles contraintes (taille, détail, transport)." },
  { n: "3", title: "Idéation", text: "Nous définissons avec vous ce que la maquette doit montrer, son échelle, ce qui s'allume ou bouge, et pour quel public." },
  { n: "4", title: "Conception et modélisation 3D", text: "Découpe en pièces, assemblage, démontage pour le transport : nous modélisons la maquette en 3D, avec un regard de design produit sur les proportions, les couleurs et la lisibilité." },
  { n: "5", title: "Fabrication", text: "Dans notre atelier à Nantes : impression 3D, ponçage, peinture, puis intégration de l'électronique (écrans, LED) et des pièces mobiles." },
  { n: "6", title: "Livraison en France", text: "Retrait sur place à Nantes ou livraison partout en France, avec un emballage adapté si la maquette est démontable." },
];

const interactive = [
  { title: "Écrans et affichages", text: "Un écran intégré pour afficher un schéma, une animation ou une vidéo de démonstration directement dans la maquette." },
  { title: "LED et animations lumineuses", text: "Éclairage, chenille lumineuse, séquences qui guident le regard ou montrent le fonctionnement d'un procédé." },
  { title: "Boutons et capteurs", text: "Le visiteur appuie, approche la main ou tourne un bouton : la maquette réagit et déclenche lumière, écran ou mouvement." },
  { title: "Pièces mobiles", text: "Éléments qui tournent, coulissent ou s'ouvrent, pour montrer un mécanisme ou découvrir l'intérieur d'un équipement." },
];

const gallery = [
  { img: "/assets/real-1.webp", label: "Système de filtration et de purification : équipement de procédé biotechnologique, châssis imprimé, vraie tuyauterie transparente, roulettes et presse-étoupes en métal" },
  { img: "/assets/real-19.webp", label: "Maquette de bioréacteur en inox imprimée en 3D" },
  { img: "/assets/real-21.webp", label: "Détail de vannes, leviers et manomètres à l'échelle" },
  { img: "/assets/real-8.webp", label: "Cellule biologique : maquette pédagogique en coupe, coque imprimée puis peinte à la main" },
  { img: "/assets/real-17.webp", label: "Maquettes de design produit" },
  { img: "/assets/real-2.webp", label: "Maquette d'équipement de procédé avec pompe et tuyauterie" },
];

const faqs = [
  { q: "Pouvez-vous nous aider à concevoir la maquette à partir d'une simple idée ?", a: "Oui. Nous menons l'idéation et la conception avec vous : ce que la maquette doit montrer, l'échelle, les parties mobiles ou lumineuses, puis nous la modélisons en 3D et la fabriquons dans notre atelier à Nantes." },
  { q: "Êtes-vous un maquettiste ou un service d'impression 3D ?", a: "Un maquettiste : l'impression 3D est l'un de nos outils, à côté de la découpe, du ponçage, de la peinture et de l'électronique. Notre métier, c'est la conception de la maquette (modélisation 3D, design produit, choix des finitions) jusqu'à sa livraison." },
  { q: "Réalisez-vous des maquettes d'architecture, industrielles, commerciales, de design produit, pédagogiques ou scientifiques ?", a: "Oui : maquette d'architecture, maquette industrielle, commerciale et de salon (démonstration, présentation client), maquette de design produit, maquette pédagogique et scientifique. Chaque maquette est conçue sur mesure à partir de vos plans, fichiers, photos ou d'une simple idée." },
  { q: "Quels matériaux et quelles finitions pour une maquette ?", a: "Nous choisissons la matière selon l'usage de la maquette (présentation, manipulation, démonstration). Ponçage, apprêt et peinture sont possibles selon le rendu attendu ; décrivez votre projet et nous vous conseillons dès l'étude de votre projet." },
  { q: "Quelle échelle et quelles dimensions maximales ?", a: "L'échelle se choisit librement selon votre projet. Une pièce unique est limitée par le volume de nos machines ; au-delà, la maquette est découpée en plusieurs parties puis assemblée." },
  { q: "Faut-il un fichier 3D pour commander une maquette ?", a: "Non. Avec des plans, des photos, des cotes ou même une simple description, nous pouvons modéliser la maquette nous-mêmes avant de la fabriquer." },
  { q: "Quels sont les délais ?", a: "Les délais vont d'une semaine à un mois selon le projet. Nous sommes très réactifs et les urgences sont possibles : chaque projet est sur devis sur mesure, demandez-nous le vôtre en précisant votre échéance." },
  { q: "Peut-on avoir une maquette peinte ou multicolore ?", a: "Oui. Une maquette peut être imprimée en plusieurs couleurs ou peinte après impression, par exemple pour distinguer les parties d'un modèle pédagogique." },
  { q: "Livrez-vous les maquettes hors de Nantes ?", a: "Oui, partout en France. Vous pouvez aussi retirer votre maquette à Nantes (Canclaux)." },
  { q: "Mon projet est confidentiel : signez-vous un accord de confidentialité ?", a: "Oui, sur demande nous signons un accord de confidentialité (NDA) avant que vous nous transmettiez plans et fichiers. Vos documents ne sont utilisés que pour votre maquette." },
  { q: "La maquette peut-elle être démontable et transportable pour un salon ?", a: "Oui. Nous pouvons concevoir la maquette en plusieurs modules démontables, avec un emballage adapté, pour qu'elle voyage et se remonte facilement sur votre stand. Précisez-le dans votre demande." },
  { q: "Fabriquez-vous aussi des objets ou des produits pour une marque ?", a: "Oui : objets et petits produits pour l'exposition, le marketing, le retail et les petites séries. Décrivez votre idée, même sans dessin, nous la rendons faisable et la fabriquons dans notre atelier à Nantes." },
  { q: "Combien coûte une maquette sur mesure ?", a: "Chaque maquette est unique : le devis est sur mesure et gratuit, après étude de votre projet. Nous n'affichons pas de tarif public, car il dépend de la taille, du niveau de détail et des options (LED, pièces mobiles, finitions). Décrivez votre besoin, nous vous répondons rapidement." },
];

const siteUrl = "https://nasap3d.com";
const offerTypes = [
  { name: "Maquette d'architecture", description: "Bâtiments, quartiers et aménagements à l'échelle, pour concours, promotion et présentation client." },
  { name: "Maquette industrielle, commerciale et de salon", description: "Machines, équipements, procédés et stands reproduits avec LED et pièces mobiles, démontables et transportables, pour démonstration, salon et présentation client." },
  { name: "Maquette pédagogique et scientifique", description: "Modèles en coupe et maquettes scientifiques pour laboratoires, écoles et médiation." },
  { name: "Maquette de design produit", description: "Prototype d'aspect ou maquette de gamme pour valider une forme, une couleur, une ergonomie avant l'industrialisation." },
  { name: "Prototypes et objets sur mesure pour marques", description: "Prototypes fonctionnels ou d'aspect, objets et petits produits pour exposition, marketing et retail, petites séries à partir d'une maquette validée." },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Maquettiste à Nantes : maquettes industrielles, d'architecture et de présentation",
      description:
        "Atelier de maquettiste à Nantes : idéation, conception, modélisation 3D et fabrication de maquettes sur mesure (industrielles, architecture, salon, pédagogiques, design produit), avec intégration électronique (écrans, LED), éléments interactifs et pièces mobiles. Livraison en France.",
      serviceType: "Maquettiste, maquettes sur mesure",
      url: `${siteUrl}/maquettiste-nantes`,
      inLanguage: "fr-FR",
      provider: { "@id": `${siteUrl}/#business` },
      areaServed: [
        { "@type": "City", name: "Nantes" },
        { "@type": "Country", name: "France" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Types de maquettes",
        itemListElement: offerTypes.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.name, description: o.description },
        })),
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Maquettes", item: `${siteUrl}/maquettiste-nantes` },
      ],
    },
  ],
};
---

<BaseLayout
  title="Maquettiste à Nantes : conception et fabrication | Nasap3D"
  description="Bureau d'études et maquettiste à Nantes : idéation, modélisation 3D, fabrication. Maquettes industrielles, de salon, interactives (écrans, LED)."
  path="/maquettiste-nantes"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="lp-hero">
    <h1 class="lp-title">Maquettiste à Nantes : maquettes industrielles, d'architecture et de présentation</h1>
    <p class="lp-subtitle">Bureau d'études et atelier de maquettiste à Nantes. De l'idée à l'objet : conception, modélisation 3D, fabrication, électronique intégrée.</p>
    <div class="lp-ctas">
      <a href="/contact" class="lp-btn lp-btn-primary"><span class="lp-btn-label">Demander un devis sur mesure <span class="lp-arrow" aria-hidden="true">→</span></span></a>
    </div>
  </section>

  <StoryboardCellule />

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Un bureau d'études et un atelier de maquettiste sous le même toit</h2>
    <p class="lp-note lp-intro">Nous faisons plus que des maquettes. Design produit, modélisation 3D et maîtrise de nos machines (impression multi-matériaux, résine, laser, peinture, électronique) se retrouvent dans le même atelier. Vous pouvez venir avec un plan, avec une idée à rendre faisable, ou seulement avec une idée sans dessin. Nous vous accompagnons de l'idéation jusqu'à la production.</p>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Pour qui travaille notre atelier de maquettes</h2>
    <div class="lp-steps">
      {
        audiences.map((a, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{a.title}</h3>
            <p class="lp-step-text">{a.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Maquettes interactives et intégration électronique</h2>
    <p class="lp-note">Les maquettes interactives sont notre force : nous intégrons l'électronique directement dans la maquette pour qu'elle se manipule et se démontre. Nous avons réalisé, par exemple, une cellule biologique à chenille lumineuse LED.</p>
    <div class="lp-steps lp-gap">
      {
        interactive.map((t, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{t.title}</h3>
            <p class="lp-step-text">{t.text}</p>
          </div>
        ))
      }
    </div>
    <p class="lp-note">Usages : retail et PLV (présentoir, magasin, vitrine), salon et stand, démonstrateur industriel (voir nos <a href="/maquette-industrielle">maquettes industrielles</a>), médiation scientifique et musée. Nous réalisons aussi des maquettes d'architecture, de design produit et pédagogiques ou scientifiques.</p>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">De l'idée à la maquette : comment ça se passe</h2>
    <div class="lp-steps lp-timeline">
      {
        steps.map((s, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <div class="lp-step-n">{s.n}</div>
            <h3 class="lp-step-title">{s.title}</h3>
            <p class="lp-step-text">{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Quatre types de maquettes sur mesure</h2>
    <div class="lp-steps">
      {
        types.map((t, i) =>
          t.href ? (
            <a class="lp-step lp-step-link" href={t.href} style={`--i:${i}`}>
              <h3 class="lp-step-title">{t.title} <span class="lp-arrow" aria-hidden="true">→</span></h3>
              <p class="lp-step-text">{t.text}</p>
            </a>
          ) : (
            <div class="lp-step" style={`--i:${i}`}>
              <h3 class="lp-step-title">{t.title}</h3>
              <p class="lp-step-text">{t.text}</p>
            </div>
          )
        )
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Au-delà de la maquette : prototypes, objets pour marques, petites séries</h2>
    <div class="lp-steps">
      {
        beyond.map((t, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{t.title}</h3>
            <p class="lp-step-text" set:html={t.text} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Ce qui distingue notre atelier de maquettiste</h2>
    <div class="lp-steps">
      {
        strengths.map((s, i) => (
          <div class="lp-step" style={`--i:${i}`}>
            <h3 class="lp-step-title">{s.title}</h3>
            <p class="lp-step-text">{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Nos maquettes</h2>
    <div class="lp-real-grid">
      {
        gallery.map((r, i) => (
          <figure class="lp-real" style={`--i:${i}`}>
            <img src={r.img} alt={r.label} loading="lazy" decoding="async" width="600" height="750" />
            <figcaption>
              <strong>{r.label}</strong>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {
    MAQUETTES_ACTIVES.length > 0 && (
      <section class="lp-section" data-rv>
        <h2 class="lp-h2">Explorez nos maquettes en 3D</h2>
        <p class="lp-note">Caravane de présentation : maquette de vitrine pour le secteur du loisir, carrosserie imprimée en plusieurs couleurs dans la masse, vitres et feux en plexiglas.</p>
        <MaquetteCarousel />
      </section>
    )
  }

  <section class="lp-section" data-rv>
    <MachinesStrip />
  </section>

  <section class="lp-section" data-rv>
    <h2 class="lp-h2">Questions fréquentes</h2>
    <FaqAccordion items={faqs} client:visible />
  </section>

  <section class="lp-section lp-final" data-rv>
    <h2 class="lp-h2">Un projet de maquette ?</h2>
    <p class="lp-note lp-final-note">Décrivez-nous votre besoin et votre échéance, nous vous répondons rapidement.</p>
    <div class="lp-ctas">
      <a href="/contact" class="lp-btn lp-btn-primary"><span class="lp-btn-label">Demander un devis sur mesure <span class="lp-arrow" aria-hidden="true">→</span></span></a>
    </div>
  </section>
</BaseLayout>


<script>
  // Apparition douce au défilement. Sans JS ou avec « réduire les animations », tout reste visible.
  const items = document.querySelectorAll<HTMLElement>("[data-rv]");
  if (items.length && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("lp-motion");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0, rootMargin: "0px 0px 700px 0px" },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  .lp-hero,
  .lp-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .lp-hero {
    padding-top: 40px;
    padding-bottom: 16px;
  }
  .lp-section {
    padding-bottom: 44px;
  }
  .lp-title {
    font: 700 32px/1.15 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 14px;
  }
  .lp-subtitle {
    font: 400 15px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 24px;
  }
  .lp-ctas {
    display: flex;
    gap: 12px;
  }
  .lp-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    font: 600 14px/1.35 "Inter", sans-serif;
    padding: 14px 18px;
    border-radius: 8px;
  }
  .lp-btn-secondary {
    border: 1px solid rgba(255, 90, 60, 0.6);
    background: rgba(255, 90, 60, 0.08);
    color: #f3f1ec;
  }
  .lp-h2 {
    font: 700 20px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 16px;
  }
  .lp-steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  /* Nombre impair de cartes : la dernière prend toute la ligne (pas de carte orpheline). */
  .lp-steps > :last-child:nth-child(odd) { grid-column: 1 / -1; }
  .lp-step {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 18px;
    background: #1a1917;
  }
  .lp-step-n {
    font: 700 18px "Space Grotesk", sans-serif;
    color: #ff5a3c;
    margin-bottom: 6px;
  }
  .lp-step-title {
    font: 600 14px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 6px;
  }
  .lp-step-text {
    font: 400 12px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }
  .lp-real-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .lp-real {
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    background: #1a1917;
  }
  .lp-real img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    background: #201d1b;
  }
  .lp-real figcaption {
    padding: 12px 14px;
    font: 400 12px/1.5 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
  }
  .lp-real strong {
    display: block;
    color: #f3f1ec;
    font: 600 13px "Space Grotesk", sans-serif;
  }
  .lp-final {
    border: 1px solid rgba(255, 90, 60, 0.3);
    background: rgba(255, 90, 60, 0.08);
    border-radius: 12px;
    padding: 28px 24px;
    margin-bottom: 44px;
  }

  /* Motion : entrée du hero au chargement, apparition au défilement, survols. */
