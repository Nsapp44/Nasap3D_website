---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHeader from "../components/home/HomeHeader";
import MobileNavToggle from "../components/MobileNavToggle";
import NPrintLogo from "../components/home/NPrintLogo";
import ServicesGrid from "../components/home/ServicesGrid";
import RealisationsCarousel from "../components/home/RealisationsCarousel";
import HomeReviewsCarousel from "../components/home/HomeReviewsCarousel";
import QuoteWizardSection from "../components/quote/QuoteWizardSection";
import ContactForm from "../components/ContactForm";
import ContactMap from "../components/ContactMap";
import PriceBadge from "../components/PriceBadge.astro";
import ExpertiseSteps from "../components/ExpertiseSteps.astro";
import { getPublicPricing } from "../lib/server/publicPricing";

const pricing = await getPublicPricing();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://nasap3d.com/#business",
      name: "Nasap3D",
      image: ["https://nasap3d.com/assets/logo.png", "https://nasap3d.com/assets/og-nasap3d.jpg"],
      url: "https://nasap3d.com/",
      telephone: "+33661430506",
      email: "nasap3D@gmail.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "29 rue Mellier",
        postalCode: "44100",
        addressLocality: "Nantes",
        addressCountry: "FR",
      },
      geo: { "@type": "GeoCoordinates", latitude: 47.21023, longitude: -1.580297 },
      areaServed: ["France", "Nantes", "Cholet", "Angers"],
      priceRange: "€€",
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "5.0",
        reviewCount: "54",
        bestRating: "5",
      },
      parentOrganization: { "@id": "https://nasap3d.com/#organization" },
    },
    {
      "@type": "Organization",
      "@id": "https://nasap3d.com/#organization",
      name: "Nasap3D",
      url: "https://nasap3d.com/",
      logo: "https://nasap3d.com/assets/logo.png",
    },
    {
      "@type": "WebSite",
      "@id": "https://nasap3d.com/#website",
      name: "Nasap3D",
      url: "https://nasap3d.com/",
      inLanguage: "fr-FR",
      publisher: { "@id": "https://nasap3d.com/#organization" },
    },
  ],
};
---

<BaseLayout
  title="Impression 3D en France — Devis instantané en ligne | Atelier à Nantes"
  description="Impression 3D sur mesure partout en France : devis instantané en ligne, prix calculé sur votre fichier, prototypage, pièces et petites séries. Atelier à Nantes, livraison dans toute la France."
  path="/"
  hideHeader
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <MobileNavToggle client:load />
  <HomeHeader client:load />

  <div id="sec-accueil" class="hero-wrap">
    <canvas id="nasap-mesh-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;"></canvas>
    <script>
      import "../scripts/mesh-background";
    </script>
    <div class="hero-fade"></div>
    <div class="hero-content">
      <h1 class="hero-title">Impression 3D en France</h1>
      <p class="hero-slogan">As soon as possible. Sans compromis sur la qualité.</p>
      <div class="hero-subtitle">
        Prototypage, rétro-conception, maquettage, petites séries. Le savoir-faire artisan, la cadence d'un atelier
        outillé, à Nantes, livré partout en France. Votre{" "}
        <a href="/devis-instantane" style="color: inherit; text-decoration: underline">devis instantané impression 3D</a>{" "}
        en quelques minutes.
      </div>
      <PriceBadge variant="hero" floorLabel={pricing.floorLabel} minOrderLabel={pricing.minOrderLabel} feeLabel={pricing.feeLabel} feeRule={pricing.hasSmallOrderFee} style="margin: 0 auto 26px" />
      <div class="hero-ctas">
        <a href="/devis-instantane" class="hero-cta-primary">Obtenir un devis instantané</a>
        <a href="#sec-services" class="hero-cta-secondary">Nos services</a>
      </div>
    </div>
  </div>

  <div class="section section-alt configurator-section">
    <div class="section-inner">
      <h2 class="eyebrow">Devis d'impression 3D instantané</h2>
      <ExpertiseSteps style="max-width: none; margin-bottom: 26px" />
      <QuoteWizardSection client:load />
    </div>
  </div>

  <div class="section section-alt banner-section">
    <div class="section-inner">
      <a href="/devis-instantane" class="advice-banner">
        <div>
          <h3 class="advice-title">Besoin d'aide pour choisir vos réglages&#8239;?</h3>
          <div class="advice-text">Remplissage, qualité, taille max, matériau — le guide complet + devis détaillé.</div>
        </div>
        <div class="advice-link">Voir les conseils →</div>
      </a>
    </div>
  </div>

  <div id="sec-services" class="section">
    <div class="section-inner">
      <h2 class="eyebrow">Nos services d'impression 3D et de fabrication</h2>
      <div class="eyebrow-sub">Chaque prestation a sa page dédiée</div>
      <ServicesGrid client:visible={{ rootMargin: "600px" }} />
    </div>
  </div>

  <div class="section section-alt">
    <div class="section-inner">
      <HomeReviewsCarousel idPrefix="nasap-google-home" client:visible={{ rootMargin: "600px" }} />
    </div>
  </div>

  <div id="sec-apropos" class="section about-section">
    <div class="section-inner about-grid">
      <NPrintLogo client:visible={{ rootMargin: "600px" }} />
      <div>
        <h2 class="eyebrow">Un atelier d'impression 3D à Nantes</h2>
        <h2 class="about-title">Nasap3D<br />Impression 3D, rétro-conception &amp; maquettage</h2>
        <div class="about-text">
          Nasap3D est né en 2022 à Nantes, du croisement entre savoir-faire artisanal et technologie d'impression 3D.
        </div>
      </div>
    </div>
  </div>

  <div id="sec-realisations" class="section section-alt">
    <div class="section-inner">
      <h2 class="eyebrow">Nos réalisations en impression 3D</h2>
      <RealisationsCarousel client:visible={{ rootMargin: "600px" }} />
      <div class="projet-cta-wrap">
        <div class="projet-cta-box">
          <h2 class="projet-cta-title">Un projet singulier ou original&#8239;?</h2>
          <div class="projet-cta-text">Maquette, rétro-conception d'une pièce existante, objet unique&nbsp;: décrivez-nous votre idée, même sans fichier 3D. Nous étudions sa faisabilité avant tout paiement.</div>
          <div class="projet-cta-actions">
            <a href="/contact" class="projet-cta-link">Parler de mon projet</a>
            <a href="/maquette-impression-3d" class="projet-cta-secondary">Voir le maquettage</a>
          </div>
          <a href="/realisations" class="projet-cta-more">Voir toutes nos réalisations</a>
        </div>
      </div>
    </div>
  </div>

  <div id="sec-machines" class="section">
    <div class="section-inner">
      <h2 class="eyebrow">Notre parc de machines</h2>
      <h3 class="machines-subhead">Impression 3D</h3>
      <div class="machines-grid-3">
        <div class="machine-card">
          <div class="machine-img" style="background-image:url('/assets/machine-h2c.webp')"></div>
          <div class="machine-name">Bambu Lab H2C<span class="machine-qty">x2</span></div>
        </div>
        <div class="machine-card">
          <div class="machine-img" style="background-image:url('/assets/machine-x2d.webp')"></div>
          <div class="machine-name">Bambu Lab X2D</div>
        </div>
        <div class="machine-card">
          <div class="machine-img" style="background-image:url('/assets/machine-x1c.webp')"></div>
          <div class="machine-name">Bambu Lab X1C</div>
        </div>
      </div>

      <h3 class="machines-subhead">Autres machines de l'atelier</h3>
      <div class="machines-grid-5">
        <div class="machine-card">
          <div class="machine-img machine-img-tall" style="background-image:url('/assets/machine-sla.webp')"></div>
          <div class="machine-name-sm">Imprimante SLA résine</div>
        </div>
        <div class="machine-card">
          <div class="machine-img machine-img-tall" style="background-image:url('/assets/machine-xtool-s1.webp')"></div>
          <div class="machine-name-sm">Découpeuse laser - XTOOL S1 Diode/UV</div>
        </div>
        <div class="machine-card">
          <div class="machine-img machine-img-tall" style="background-image:url('/assets/machine-laser-fibre.webp')"></div>
          <div class="machine-name-sm">Découpeuse laser - Fibre 20w</div>
        </div>
        <div class="machine-card">
          <div class="machine-img machine-img-tall" style="background-image:url('/assets/machine-cricut.webp')"></div>
          <div class="machine-name-sm">Cricut - découpe vinyle, stickers, plastique</div>
        </div>
        <div class="machine-card">
          <div class="machine-img machine-img-tall" style="background-image:url('/assets/machine-presse.webp')"></div>
          <div class="machine-name-sm">Presse à chaud - transfert vinyle &amp; sublimation</div>
        </div>
      </div>
    </div>
  </div>

  <div class="section seo-section">
    <div class="section-inner">
      <div class="seo-text">
        <h2 class="seo-title">Impression 3D sur mesure, à l'unité ou en série</h2>
        <p class="seo-intro">Nasap3D est un atelier d'impression 3D en France, installé à Nantes depuis 2022. Déposez votre fichier sur le devis instantané, nous livrons partout en France. Nous fabriquons des pièces sur mesure pour les particuliers, les artisans, les entreprises et les architectes&nbsp;: pièce de remplacement introuvable, prototype, support technique, petite série ou maquette.</p>
        <div class="seo-grid">
          <div class="seo-card">
            <h3>Vous avez un fichier 3D&#8239;?</h3>
            <p>Déposez-le sur notre <a href="/devis-instantane">devis instantané</a>&nbsp;: le prix est calculé sur votre fichier en quelques minutes, à partir de {pricing.floorLabel} la pièce. Sans fichier, envoyez des photos et les dimensions&nbsp;: nous redessinons la pièce en 3D (rétro-conception), puis nous l'imprimons.</p>
          </div>
          <div class="seo-card">
            <h3>Expertise avant fabrication</h3>
            <p>Nous vérifions la faisabilité, la matière et la solidité de la pièce, et vous ne payez qu'une fois la commande acceptée. Matières&nbsp;: PLA, PETG, ABS, ASA, TPU, PP et Nylon sur imprimantes Bambu Lab H2C, X2D et X1C, résine pour les détails très fins. Gravure laser sur métal et sur bois, maquettes d'architecture.</p>
          </div>
          <div class="seo-card">
            <h3>Livraison en France et en Europe</h3>
            <p>Livraison partout en France et en Europe, ou retrait gratuit à l'atelier de Nantes sur rendez-vous.</p>
          </div>
        </div>
        <p>Nos clients nous notent 5,0 sur 54&nbsp;avis Google&nbsp;: arceau de casque audio réparé et renforcé, engrenage de scie à onglet qui n'était plus fabriqué, pièce complexe pour l'aéronautique de loisir, série de 528&nbsp;pièces en TPU.</p>
        <p>Particulier&#8239;? Lisez notre <a href="/impression-3d-particuliers">guide de l'impression 3D pour particuliers</a>. Pour comparer les matières ou estimer un budget, consultez les guides des <a href="/materiaux-impression-3d">matériaux</a> et des <a href="/prix-impression-3d">prix</a>, ou découvrez l'<a href="/impression-3d-en-ligne">impression 3D en ligne</a>.</p>
      </div>
    </div>
  </div>

  <div id="sec-contact" class="section section-alt">
    <div class="section-inner">
      <h2 class="contact-title">Contacter l'atelier à Nantes</h2>
      <p class="contact-sub">Retrait gratuit à l'atelier sur rendez-vous.</p>
      <div class="contact-grid">
        <ContactForm client:visible={{ rootMargin: "600px" }} />
        <div class="contact-info">
          <div class="contact-info-title">Nasap3D</div>
          <address class="contact-lines">
            <span>29 rue Mellier, 44100 Nantes</span>
            <a href="tel:+33661430506">06 61 43 05 06</a>
            <a href="mailto:nasap3D@gmail.com">nasap3D@gmail.com</a>
          </address>
          <div class="contact-map">
            <ContactMap height="300px" client:visible={{ rootMargin: "600px" }} />
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-wrap {
    position: relative;
    overflow: hidden;
    padding: 56px 24px 40px;
    text-align: center;
    background: #161514;
  }
  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 90px;
    background: linear-gradient(to bottom, transparent, #161514);
    z-index: 1;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
  }
  .hero-title {
    font: 700 40px/1.12 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 10px;
    text-wrap: balance;
  }
  .hero-slogan {
    font: 600 18px/1.3 "Space Grotesk", sans-serif;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 auto 16px;
    text-wrap: balance;
  }
  .hero-subtitle {
    font: 400 13.5px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    max-width: 520px;
    margin: 0 auto 24px;
    text-wrap: pretty;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 34px;
  }
  .hero-cta-primary,
  .hero-cta-secondary {
    white-space: nowrap;
    text-decoration: none;
    font: 600 13px "Inter", sans-serif;
    padding: 12px 22px;
    border-radius: 7px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .hero-cta-primary {
    background: #ff5a3c;
    color: #161514;
  }
  .hero-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(255, 90, 60, 0.35);
  }
  .hero-cta-secondary {
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #1e1c1a;
    color: #f3f1ec;
    font-weight: 500;
  }
  .hero-cta-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
    border-color: #ff5a3c;
  }

  .section {
    padding: 44px 24px;
    background: #161514;
  }
  .section-alt {
    background: #141312;
  }
  .configurator-section,
  .banner-section {
    padding: 40px 24px;
  }
  .banner-section {
    padding-top: 0;
  }
  .section-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .eyebrow {
    font: 600 11.5px "Inter", sans-serif;
    color: #ff5a3c;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
    text-wrap: balance;
  }
  .eyebrow-sub {
    font: 400 11.5px "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 18px;
  }
  .configurator-section .eyebrow {
    margin-bottom: 20px;
  }

  .advice-banner {
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid rgba(255, 90, 60, 0.35);
    background: rgba(255, 90, 60, 0.1);
    border-radius: 10px;
    padding: 20px 24px;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .advice-banner:hover {
    border-color: #ff5a3c;
    transform: scale(1.02);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
  }
  .advice-title {
    font: 700 14px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 3px;
    text-wrap: balance;
  }
  .advice-text {
    font: 400 11px/1.5 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    text-wrap: pretty;
  }
  .advice-link {
    font: 600 11px "Inter", sans-serif;
    color: #ff5a3c;
    white-space: nowrap;
    width: fit-content;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    transition: padding 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .advice-banner:hover .advice-link {
    padding: 6px 12px;
    border-color: #ff5a3c;
    background: rgba(255, 90, 60, 0.1);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    align-items: center;
  }
  .about-title {
    font: 700 19px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 8px;
    text-wrap: balance;
  }
  .about-text {
    font: 400 12px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.5);
    max-width: 520px;
    text-wrap: pretty;
  }

  .seo-section {
    padding-top: 0;
  }
  .seo-title {
    font: 700 22px/1.25 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 14px;
    text-wrap: balance;
  }
  .seo-text {
    text-align: left;
  }
  .seo-text p {
    font: 400 14px/1.65 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .seo-text .seo-intro {
    max-width: 75ch;
    margin-bottom: 22px;
  }
  .seo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 22px;
  }
  .seo-card {
    background: #1a1917;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 20px;
  }
  .seo-card h3 {
    font: 600 16px/1.3 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 10px;
  }
  .seo-card p {
    margin: 0;
  }
  .seo-text a {
    color: #ff5a3c;
    text-decoration: none;
  }
  .seo-text a:hover {
    color: #ff7a5c;
    text-decoration: underline;
  }
  .seo-text a:focus-visible {
    outline: 2px solid #ff5a3c;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .machines-subhead {
    font: 600 9.5px "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 10px;
    text-wrap: balance;
  }
  .machines-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 26px;
  }
  .machines-grid-5 {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .machine-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    background: #1a1917;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .machine-card:hover {
    border-color: #ff5a3c;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
    transform: translateY(-3px);
  }
  .machine-img {
    aspect-ratio: 1/1;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .machine-img-tall {
    aspect-ratio: auto;
    height: 185px;
  }
  .machine-name {
    padding: 10px 12px;
    font: 600 11px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .machine-qty {
    font: 700 8.5px "Inter", sans-serif;
    color: #ff5a3c;
    background: rgba(255, 90, 60, 0.12);
    border-radius: 4px;
    padding: 2px 6px;
  }
  .machine-name-sm {
    padding: 10px 12px;
    font: 600 10.5px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    line-height: 1.3;
  }

  .contact-title {
    font: 700 22px/1.25 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin: 0 0 6px;
  }
  .contact-sub {
    font: 400 14px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 24px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .contact-info {
    font: 400 14px/1.7 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.7);
  }
  .contact-info-title {
    font: 600 16px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 8px;
  }
  .contact-lines {
    display: grid;
    gap: 2px;
    font-style: normal;
  }
  .contact-lines a {
    color: #ff5a3c;
    text-decoration: none;
    width: fit-content;
  }
  .contact-lines a:hover {
    text-decoration: underline;
  }
  .contact-lines a:focus-visible {
    outline: 2px solid #ff5a3c;
    outline-offset: 2px;
    border-radius: 2px;
  }
  .contact-map {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 16px;
    box-sizing: border-box;
  }

  .projet-cta-wrap {
    margin-top: 26px;
    text-align: center;
  }
  .projet-cta-box {
    border: 1px solid rgba(255, 90, 60, 0.3);
    background: rgba(255, 90, 60, 0.08);
    border-radius: 12px;
    padding: 28px;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .projet-cta-box:hover {
    border-color: #ff5a3c;
    transform: scale(1.02);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
  }
  .projet-cta-title {
    font: 700 17px "Space Grotesk", sans-serif;
    color: #f3f1ec;
