---
import BaseLayout from "../layouts/BaseLayout.astro";

// Page « à venir » de Nasap Shop, servie sur shop.nasap3d.com (voir src/middleware.ts).
// Langage visuel repris de la maquette boutique (NASAP-SHOP/BRANDING.md, maquette-v14).
const collections = [
  { name: "Souvenirs d'animaux", text: "Le portrait de votre animal, en relief, à partir de sa photo.", dot: "#7f9a7a" },
  { name: "Mariage", text: "Des souvenirs du grand jour, pensés pour durer et se transmettre.", dot: "#e8a598" },
  { name: "Cadeaux personnalisés", text: "Un objet unique, à partir de vos photos ou de vos idées.", dot: "#ffc93c" },
];
const steps = [
  { n: "1", title: "Vous envoyez votre photo", text: "Gratuit, sans engagement." },
  { n: "2", title: "Nous faisons l'expertise", text: "Un humain vérifie et ajuste votre pièce avant tout paiement." },
  { n: "3", title: "Fabriqué à Nantes", text: "Imprimé, assemblé et contrôlé à la main dans notre atelier." },
];
---

<BaseLayout
  title="Nasap Shop — objets sur mesure imprimés en 3D, bientôt en ligne"
  description="Nasap Shop, la boutique de l'atelier Nasap3D à Nantes : souvenirs d'animaux, mariage et cadeaux personnalisés, fabriqués sur mesure à partir de vos photos. Ouverture prochainement."
  path="/shop"
  canonicalUrl="https://shop.nasap3d.com/"
  hideHeader
  hideFooter
>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" />

  <div class="ns">
    <p class="ns-topbar">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Aucun paiement à la commande : un humain valide d'abord votre pièce.
    </p>

    <header class="ns-head">
      <div class="ns-wrap ns-head-in">
        <a href="/" class="ns-brand" aria-label="Nasap Shop, accueil">
          <img class="ns-brand-sym" src="/assets/nasap-shop-symbole.svg" width="60" height="36" alt="" />
          <span class="ns-brand-name">Nasap <span>Shop</span></span>
        </a>
        <nav class="ns-head-nav" aria-label="Liens">
          <a class="ns-navlink" href="https://nasap3d.com/">L'atelier Nasap3D</a>
          <a class="ns-btn ns-btn-primary ns-btn-sm" href="https://nasap3d.com/contact">Être prévenu</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="ns-hero">
        <div class="ns-wrap ns-hero-grid">
          <div class="ns-hero-copy">
            <p class="ns-kicker ns-in" style="--d:0ms">Ouverture prochainement · Nantes</p>
            <h1 class="ns-h1 ns-in" style="--d:60ms">Des objets sur mesure, à partir de vos photos.</h1>
            <p class="ns-lead ns-in" style="--d:120ms">
              Nasap Shop, c'est la boutique de l'atelier Nasap3D : des pièces imprimées en 3D, fidèles à votre photo, relues et ajustées à la main à Nantes. Les premières collections arrivent.
            </p>
            <div class="ns-actions ns-in" style="--d:180ms">
              <a class="ns-btn ns-btn-primary" href="https://nasap3d.com/contact">
                Être prévenu de l'ouverture
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <a class="ns-btn ns-btn-ghost" href="https://nasap3d.com/devis-instantane">Un projet dès maintenant</a>
            </div>
            <p class="ns-hint ns-in" style="--d:220ms">En attendant, l'atelier fabrique déjà vos pièces sur mesure.</p>
          </div>

          <div class="ns-hero-art ns-in" style="--d:120ms" aria-hidden="true">
            <div class="ns-board">
              <img class="ns-tag-big" src="/assets/nasap-shop-symbole.svg" width="300" height="180" alt="" />
              <span class="ns-board-label">Bientôt sur l'étagère</span>
              <span class="ns-shelf"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="ns-sec" aria-labelledby="ns-collections">
        <div class="ns-wrap">
          <p class="ns-kicker">Les premières collections</p>
          <h2 id="ns-collections" class="ns-h2">Ce qui arrive sur la boutique</h2>
          <ul class="ns-cards">
            {collections.map((c) => (
              <li class="ns-card">
                <span class="ns-pricetag">Bientôt</span>
                <span class="ns-dot" style={`--dot:${c.dot}`}></span>
                <h3 class="ns-h3">{c.name}</h3>
                <p>{c.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="ns-sec ns-sec-alt" aria-labelledby="ns-how">
        <div class="ns-wrap">
          <p class="ns-kicker">De la photo à l'objet</p>
          <h2 id="ns-how" class="ns-h2">Comment ça marchera</h2>
          <ol class="ns-steps">
            {steps.map((s) => (
              <li class="ns-step">
                <span class="ns-step-n">{s.n}</span>
                <h3 class="ns-h3">{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
          <div class="ns-band">
            <p>Une idée de cadeau qui ne peut pas attendre l'ouverture ?</p>
            <a class="ns-btn ns-btn-ink" href="https://nasap3d.com/devis-instantane">Demander un devis</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="ns-foot">
      <div class="ns-wrap ns-foot-in">
        <span class="ns-foot-brand"><img src="/assets/nasap-shop-symbole.svg" width="30" height="18" alt="" /> Nasap Shop, par l'atelier <a href="https://nasap3d.com/">Nasap3D</a> · Nantes</span>
        <a href="https://nasap3d.com/mentions-legales">Mentions légales</a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .ns {
    --paper: #faf6f0; --paper2: #f3ece2; --ink: #1c1a18; --text: #3d3833; --soft: #6f665d;
    --accent: #ff5a3c; --accent-dk: #c2391f; --walnut: #6b4a33; --line: rgba(28, 26, 24, 0.1);
    --ease: cubic-bezier(.16, 1, .3, 1);
    --shadow: 0 1px 0 rgba(28, 26, 24, .06), 0 8px 16px -10px rgba(28, 26, 24, .35);
    font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--text);
    background: var(--paper);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .ns main { flex: 1; }
  .ns *, .ns *::before, .ns *::after { box-sizing: border-box; }
  .ns a:focus-visible { outline: 3px solid #3b6fd8; outline-offset: 3px; border-radius: 8px; }
  .ns-wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }

  /* Bandeau du haut */
  .ns-topbar {
    margin: 0; padding: 8px 16px; text-align: center; font-size: 13px; color: var(--text);
    background: var(--paper2); border-bottom: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .ns-topbar svg { color: var(--accent-dk); flex: none; }

  /* En-tête */
  .ns-head { background: var(--paper); border-bottom: 1px solid rgba(28, 26, 24, 0.08); }
  .ns-head-in { min-height: 79px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .ns-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .ns-brand-sym { display: block; }
  .ns-brand-name {
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-weight: 700; font-size: 28px;
    line-height: 1; white-space: nowrap; color: var(--ink);
  }
  .ns-brand-name span { color: var(--accent); }
  .ns-head-nav { display: flex; align-items: center; gap: 24px; }
  .ns-navlink { color: var(--ink); font-size: 15px; font-weight: 500; text-decoration: none; }

  /* Boutons (pilules, comme la maquette boutique) */
  .ns-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 52px; padding: 0 26px; border-radius: 999px;
    font-size: 16px; font-weight: 500; text-decoration: none; color: var(--ink);
    transition: background .2s var(--ease), color .2s var(--ease), transform .2s var(--ease);
  }
  .ns-btn-sm { height: 44px; padding: 0 20px; font-size: 15px; }
  .ns-btn-primary { background: var(--accent); }
  .ns-btn-ghost { background: transparent; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .ns-btn-ink { background: var(--ink); color: var(--paper); }
  @media (hover: hover) and (pointer: fine) {
    .ns-navlink:hover { color: var(--accent-dk); }
    .ns-btn-primary:hover { background: #ff7a61; color: var(--ink); }
    .ns-btn-ghost:hover { background: var(--ink); color: var(--paper); }
    .ns-btn-ink:hover { background: var(--accent); color: var(--ink); }
    .ns-btn-primary:hover svg { transform: translateX(3px); }
  }
  .ns-btn svg { transition: transform .2s var(--ease); }

  /* Typo */
  .ns-kicker {
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-weight: 700; font-size: 16px;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--accent-dk); margin: 0 0 14px;
  }
  .ns-h1, .ns-h2, .ns-h3 { font-family: "Space Grotesk", system-ui, sans-serif; color: var(--ink); margin: 0; text-wrap: balance; }
  .ns-h1 { font-size: clamp(40px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -0.02em; font-weight: 700; }
  .ns-h2 { font-size: clamp(30px, 3.2vw, 42px); line-height: 1.1; letter-spacing: -0.015em; font-weight: 700; margin-bottom: 32px; }
  .ns-h3 { font-size: 20px; line-height: 1.25; font-weight: 700; margin-bottom: 6px; }

  /* Hero */
  .ns-hero { padding: 64px 0 88px; }
  .ns-hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .ns-lead { font-size: 18px; line-height: 1.6; margin: 24px 0 30px; max-width: 34em; }
  .ns-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .ns-hint { font-size: 14px; color: var(--soft); margin: 16px 0 0; }

  /* Étiquette suspendue au-dessus d'une étagère en noyer */
  .ns-board {
    position: relative; aspect-ratio: 5 / 4; border-radius: 16px; background: var(--paper2);
    border: 1px solid var(--line); box-shadow: var(--shadow); overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  .ns-tag-big {
    width: min(62%, 300px); height: auto; transform: rotate(-4deg); transform-origin: 50% 0;
    filter: drop-shadow(0 12px 14px rgba(28, 26, 24, 0.18));
    animation: ns-swing 5s ease-in-out infinite;
  }
  @keyframes ns-swing { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(-1deg); } }
  .ns-board-label {
    margin-top: 22px; font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-weight: 700;
    font-size: 18px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--soft);
  }
  .ns-shelf {
    position: absolute; left: 8%; right: 8%; bottom: 12%; height: 12px; border-radius: 3px;
    background: linear-gradient(#80593e, var(--walnut)); box-shadow: 0 10px 14px -8px rgba(28, 26, 24, 0.45);
  }

  /* Sections */
  .ns-sec { padding: 88px 0; border-top: 1px solid var(--line); }
  .ns-sec-alt { background: var(--paper2); }
  .ns-cards, .ns-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .ns-card {
    position: relative; background: #fff; border: 1px solid var(--line); border-radius: 16px;
    padding: 28px 24px 26px; box-shadow: var(--shadow);
    transition: transform .3s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) { .ns-card:hover { transform: translateY(-3px); } }
  .ns-card p, .ns-step p { margin: 0; font-size: 15px; line-height: 1.55; }
  .ns-dot { display: block; width: 36px; height: 36px; border-radius: 50%; background: var(--dot); margin-bottom: 18px; }
  .ns-pricetag {
    position: absolute; top: 22px; right: 20px;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-weight: 700; font-size: 14px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink);
    background: var(--accent); padding: 4px 12px 4px 18px;
    clip-path: polygon(9px 0, 100% 0, 100% 100%, 9px 100%, 0 50%);
    border-radius: 0 4px 4px 0; transform: rotate(-4deg);
  }
  .ns-pricetag::before {
    content: ""; position: absolute; left: 8px; top: 50%; width: 5px; height: 5px; margin-top: -2.5px;
    border-radius: 50%; background: var(--paper);
  }
  .ns-step { padding-top: 4px; }
  .ns-step-n {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--ink); color: var(--paper); font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700; font-size: 17px; margin-bottom: 16px;
  }
  .ns-band {
    margin-top: 56px; padding: 30px 36px; border-radius: 16px; background: var(--paper);
    border: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .ns-band p { margin: 0; font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 22px; color: var(--ink); }

  /* Pied de page */
  .ns-foot { background: var(--ink); color: #d9d1c7; font-size: 14px; }
  .ns-foot-in { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; padding-top: 16px; padding-bottom: 16px; }
  .ns-foot-brand { display: inline-flex; align-items: center; gap: 10px; }
  .ns-foot a { color: #ffb4a3; }

  /* Entrée (ADN Nasap : translateY 6px, 0,5 s) */
  .ns-in { animation: ns-in .5s var(--ease) both; animation-delay: var(--d, 0ms); }
  @keyframes ns-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .ns-in, .ns-tag-big { animation: none; }
    .ns-btn, .ns-card, .ns-btn svg { transition: none; }
  }

  /* Tablette */
  @media (max-width: 900px) {
    .ns-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .ns-hero-art { max-width: 520px; width: 100%; margin: 0 auto; }
    .ns-cards, .ns-steps { grid-template-columns: 1fr; gap: 16px; }
    .ns-steps { gap: 28px; }
  }
  /* Mobile */
  @media (max-width: 640px) {
    .ns-wrap { padding: 0 16px; }
    .ns-topbar { font-size: 12px; }
    .ns-head-in { min-height: 64px; }
    .ns-brand-sym { width: 50px; height: 30px; }
    .ns-brand-name { font-size: 24px; }
    .ns-navlink { display: none; }
    .ns-hero { padding: 40px 0 56px; }
    .ns-board { aspect-ratio: 16 / 11; }
    .ns-lead { font-size: 16px; margin: 18px 0 24px; }
    .ns-actions .ns-btn { width: 100%; }
    .ns-sec { padding: 56px 0; }
    .ns-h2 { margin-bottom: 24px; }
    .ns-band { padding: 24px 20px; margin-top: 40px; }
    .ns-band p { font-size: 19px; }
    .ns-band .ns-btn { width: 100%; }
    .ns-foot-in { justify-content: center; text-align: center; }
  }
</style>
