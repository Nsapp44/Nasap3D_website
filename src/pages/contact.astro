---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm";
import ContactMap from "../components/ContactMap";
---

<BaseLayout
  title="Contact — Nasap3D, Impression 3D à Nantes"
  description="Contactez Nasap3D pour votre projet d'impression 3D : 29 rue Mellier, 44100 Nantes — 06 61 43 05 06."
  path="/contact"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script is:inline src="https://js.hcaptcha.com/1/api.js?render=explicit&hl=fr" async defer></script>
  </Fragment>

  <div class="hero">
    <div class="kicker">Contact</div>
    <div class="hero-title">Parlons de votre projet</div>
    <div class="hero-intro">
      Pièce complexe, rétro-conception, maintenance, question sur un devis — écrivez-nous. Fichier prêt et besoin
      standard ? Le <a href="/devis-instantane">devis instantané</a> ira plus vite.
    </div>
  </div>

  <div class="grid">
    <div class="form-panel">
      <ContactForm client:load />
    </div>

    <div class="info-panel">
      <div class="info-title">Nasap3D</div>
      <div class="info-text">29 rue Mellier, 44100 Nantes<br />06 61 43 05 06<br />nasap3D@gmail.com</div>
      <div class="map-frame">
        <ContactMap client:load />
      </div>
      <div class="info-footnote">
        Retrait gratuit à l'atelier sur rendez-vous, ou expédition en France et dans le reste de l'Union européenne.
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 56px 24px 20px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .kicker {
    font: 600 12px "Inter", sans-serif;
    letter-spacing: 1.2px;
    color: #ff5a3c;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .hero-title {
    font: 700 30px/1.15 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 10px;
  }
  .hero-intro {
    font: 400 13px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    max-width: 560px;
  }
  .grid {
    padding: 20px 24px 56px;
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
  }
  .form-panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: #1a1917;
    padding: 28px;
  }
  .info-title {
    font: 700 15px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 14px;
  }
  .info-text {
    font: 400 12.5px/2 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 22px;
  }
  .map-frame {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    background: #1a1917;
    margin-bottom: 16px;
    width: 100%;
  }
  .info-footnote {
    font: 400 10.5px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
