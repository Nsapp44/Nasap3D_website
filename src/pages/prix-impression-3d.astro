---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExpertiseSteps from "../components/ExpertiseSteps.astro";
import GuideArticle from "../components/guides/GuideArticle.astro";
import GuideHero from "../components/guides/GuideHero.astro";
import GuideToc from "../components/guides/GuideToc.astro";
import GuideSection from "../components/guides/GuideSection.astro";
import GuidePriceCards from "../components/guides/GuidePriceCards.astro";
import GuideTable from "../components/guides/GuideTable.astro";
import GuideFaq from "../components/guides/GuideFaq.astro";
import GuideCta from "../components/guides/GuideCta.astro";
import GuideRelated from "../components/guides/GuideRelated.astro";
import { getPublicPricing } from "../lib/server/publicPricing";

// Plancher, minimum de commande et frais : réglages admin (repli sur les valeurs par défaut).
const { floorLabel, minOrderLabel, feeLabel, hasSmallOrderFee } = await getPublicPricing();
const minOrderText = hasSmallOrderFee ? ` Commande minimum ${minOrderLabel} ; en dessous, ${feeLabel} de frais de petite commande.` : "";

const PATH = "/prix-impression-3d";
const TITLE = "Prix impression 3D : tarifs et exemples réels | Nasap3D";
const DESCRIPTION =
  `Combien coûte une impression 3D ? Prix calculé sur votre fichier (matière + temps machine), dès ${floorLabel} la pièce TTC, exemples réels.`;
const H1 = "Prix d'une impression 3D : combien coûte votre pièce ?";
const LEAD =
  `Chez Nasap3D, le prix se calcule sur votre fichier : poids de matière et temps machine, mesurés par un vrai tranchage 3D. À partir de ${floorLabel} la pièce, prix TTC : le prix affiché est le prix payé.`;

const toc = [
  { label: "Comment le prix est calculé", href: "#calcul" },
  { label: "Exemples de prix réels", href: "#exemples" },
  { label: "Ce qui fait monter ou baisser le prix", href: "#variations" },
  { label: "Minimum, remise, livraison et emballage", href: "#minimum-livraison" },
  { label: "Prix affiché = prix payé", href: "#prix-paye" },
  { label: "Obtenir votre prix exact", href: "#prix-exact" },
  { label: "Questions fréquentes", href: "#faq" },
];

const prices = [
  { what: "Petite pièce en PLA · 8 g · 15 min d'impression", price: floorLabel, note: "minimum par pièce" },
  { what: "Cube de 50 mm en PETG · 103 g · 5 h 49 d'impression", price: "31,76 €" },
];

const exampleHeaders = ["Exemple", "Matière et réglages", "Poids", "Temps d'impression", "Prix d'une pièce"];
const exampleRows = [
  ["Petite pièce", "PLA, qualité standard", "8 g", "15 min", floorLabel],
  ["Cube de 50 mm", "PETG, qualité fine (couche de 0,12 mm), remplissage 60 %", "103 g", "5 h 49", "31,76 €"],
];

const faq = [
  { q: "Quel est le prix minimum d'une impression 3D ?", a: `À partir de ${floorLabel} la pièce, hors livraison : c'est le prix minimum par pièce. Une petite pièce rapide, par exemple une pièce en PLA de 8 g imprimée en 15 minutes, est facturée à ce minimum.${minOrderText}` },
  { q: "Pourquoi ne pas afficher un prix au kilo ?", a: "Le poids ne dit pas combien de temps la machine travaille. La qualité choisie, le remplissage et la forme de la pièce changent la durée d'impression, donc le prix. Nous mesurons la matière et le temps sur votre fichier, par un vrai tranchage 3D, et nous affichons le prix final de votre pièce." },
  { q: "Y a-t-il une remise si je commande plusieurs exemplaires ?", a: "Oui. Une remise automatique s'applique dès 5 exemplaires d'une même pièce, et elle augmente par paliers avec la quantité. Elle apparaît dans le configurateur et dans le panier." },
  { q: "La livraison est-elle comprise dans le prix ?", a: "Non, le prix affiché est celui de la pièce, hors livraison. Les frais de port sont calculés dans le panier selon votre adresse : Mondial Relay en point relais ou Colissimo à domicile, en France et dans l'Union européenne, avec un forfait d'emballage de 1,50 €. Retrait gratuit à l'atelier de Nantes, sur rendez-vous." },
  { q: "Le prix affiché inclut-il la TVA ?", a: "Oui, les prix sont affichés TTC : le prix affiché est le prix que vous payez pour la pièce. Seule la livraison s'ajoute, sauf retrait à l'atelier." },
  { q: "Dois-je payer au moment de commander ?", a: "Non. Aucun paiement à la commande. Expertise et validation de votre pièce en amont : nous vérifions votre fichier sous 24 à 48 h, puis vous payez en ligne depuis votre compte client (Stripe) une fois la commande acceptée." },
];
---
<BaseLayout title={TITLE} description={DESCRIPTION} path={PATH}>
  <GuideArticle>
    <GuideHero
      path={PATH}
      crumbLabel="Prix de l'impression 3D"
      eyebrow="Guide · Prix"
      title={H1}
      lead={LEAD}
      description={DESCRIPTION}
      primaryLabel="Calculer le prix de ma pièce"
      showSecondary={false}
      chips={[
        { text: "5,0 · 54 avis Google", star: true },
        { text: `Dès ${floorLabel} la pièce` },
        { text: "Prix TTC" },
      ]}
    >
      <ExpertiseSteps style="margin: 6px 0 8px" />
    </GuideHero>

    <GuideToc items={toc} />

    <GuideSection id="calcul" title="Comment le prix d'une impression 3D est calculé">
      <p>Le prix d'une impression 3D n'est ni une grille au volume ni un forfait au jugé. Chez Nasap3D, il repose sur deux mesures prises sur votre fichier : la <strong>matière</strong> que la pièce consomme et le <strong>temps</strong> pendant lequel la machine travaille.</p>
      <ol>
        <li><strong>Votre fichier est tranché.</strong> Notre logiciel découpe votre pièce en couches, exactement comme avant une vraie impression. Il ne devine pas le résultat : il le simule.</li>
        <li><strong>Il mesure le poids de matière.</strong> Plus la pièce est volumineuse ou dense, plus elle consomme de matière. Chaque matière (PLA, PETG, ABS, ASA, TPU, PP, Nylon) a son propre coût.</li>
        <li><strong>Il mesure le temps machine.</strong> Chaque heure d'impression occupe une imprimante de l'atelier. Sur une grosse pièce ou en qualité fine, c'est souvent cette partie qui pèse le plus lourd dans le prix.</li>
        <li><strong>Le prix minimum s'applique si besoin.</strong> Une très petite pièce, légère et rapide, donne un total très faible. C'est alors le minimum par pièce, {floorLabel}, qui s'applique tel quel.</li>
      </ol>
      <p>Aucun frais fixe n'est ajouté au calcul. Le résultat dépend donc de votre pièce, pas d'un barème général.</p>
      <p>Le calcul tient aussi compte de l'échelle que vous choisissez, de l'orientation d'impression retenue pour limiter les surplombs et des supports nécessaires. Ils sont inclus dans le poids et le temps mesurés, donc dans le prix affiché.</p>
      <p>Enfin, le prix est recalculé sur notre serveur au moment de l'ajout au panier. Le montant que vous payez correspond exactement à ce qui a été mesuré sur votre fichier. Pour le voir sur votre pièce, le <a href="/devis-instantane">devis instantané</a> le fait en quelques minutes.</p>
    </GuideSection>

    <GuideSection id="exemples" title="Exemples de prix réels">
      <p>Voici deux calculs réels de notre devis instantané, avec les mesures prises sur chaque pièce. Les prix s'entendent pour une pièce, hors livraison.</p>
      <GuidePriceCards items={prices} />
      <GuideTable label="Deux exemples de prix d'impression 3D avec leurs mesures" headers={exampleHeaders} rows={exampleRows} />
      <h3>Petite pièce en PLA : 8 g, 15 minutes</h3>
      <p>Cette pièce consomme très peu de matière et occupe la machine un quart d'heure. Son calcul tombe largement sous le prix minimum : c'est donc le minimum par pièce, {floorLabel}, qui fixe le prix. Vous ne voyez aucune ligne « frais minimum » à part, seulement un prix normal.</p>
      <h3>Cube de 50 mm en PETG : 103 g, 5 h 49</h3>
      <p>Ici, le calcul dépasse déjà le prix minimum. La qualité fine demande près de six heures de machine, et c'est ce temps machine qui pèse le plus lourd dans le prix, bien plus que la matière : 31,76 €.</p>
      <p>Ces deux exemples montrent l'essentiel : le poids seul ne suffit pas à prévoir un prix. Pour connaître celui de votre pièce, le plus simple est de <a href="/devis-instantane">déposer votre fichier</a>.</p>
    </GuideSection>

    <GuideSection id="variations" title="Ce qui fait monter ou baisser le prix">
      <p>Deux pièces du même poids peuvent coûter un prix différent. Voici ce qui change le prix, et ce que vous pouvez ajuster dans le devis instantané.</p>
      <ul>
        <li><strong>La taille de la pièce.</strong> Une pièce plus grande consomme plus de matière et demande plus de temps. Vérifiez aussi l'unité de votre fichier (millimètres, centimètres, pouces) : une unité mal exportée change complètement la taille, donc le prix. Le configurateur permet de la corriger.</li>
        <li><strong>Le remplissage.</strong> Une pièce pleine ou renforcée consomme plus de matière et s'imprime plus longtemps qu'une pièce décorative. Le configurateur propose plusieurs niveaux, du plus léger au quasi plein.</li>
        <li><strong>La qualité d'impression.</strong> Une couche épaisse (0,28 mm, qualité rapide) est plus rapide et moins chère. La qualité standard (0,20 mm) est le réglage par défaut. La qualité fine (0,12 mm) donne plus de détails et une surface plus lisse, mais le temps d'impression est nettement plus long.</li>
        <li><strong>La matière.</strong> Chaque matière a son propre coût. Choisissez d'abord selon l'usage (chaleur, extérieur, souplesse), le prix vient ensuite : le <a href="/materiaux-impression-3d">guide des matériaux</a> compare les sept matières proposées.</li>
        <li><strong>Les supports et l'orientation.</strong> Une pièce avec des surplombs peut demander des supports, qui consomment de la matière et du temps. Notre logiciel teste plusieurs orientations et retient celle qui limite les surplombs.</li>
        <li><strong>La quantité.</strong> Commander plusieurs exemplaires d'une même pièce déclenche une remise automatique dès 5 exemplaires (détail plus bas).</li>
      </ul>
      <p>Pour faire baisser le prix sans perdre en qualité, adaptez les réglages à l'usage. Une pièce décorative n'a pas besoin du même remplissage qu'une pièce soumise à des efforts. Une pièce brute ou de gros volume peut se contenter de la qualité rapide, avec des lignes de couche visibles.</p>
      <p>Un doute sur un réglage ? Gardez les valeurs par défaut : nous vérifions votre choix pendant l'expertise, et nous vous prévenons avant de fabriquer si quelque chose cloche.</p>
    </GuideSection>

    <GuideSection id="minimum-livraison" title="Minimum de commande, remise dès 5 exemplaires, livraison et emballage">
      <ul>
        <li><strong>Prix minimum par pièce : {floorLabel}.</strong> Aucune pièce n'est facturée en dessous, même la plus petite.</li>
        {hasSmallOrderFee && <li><strong>Commande minimum de {minOrderLabel}.</strong> En dessous, {feeLabel} de frais de petite commande s'ajoutent. Ils sont affichés dans le panier avec une explication.</li>}
        <li><strong>Remise automatique dès 5 exemplaires.</strong> Pour une même pièce, la remise augmente par paliers avec la quantité. Elle apparaît dans le configurateur et sur la ligne « Remise quantité » du panier.</li>
        <li><strong>Livraison en point relais ou à domicile.</strong> Vous saisissez votre adresse dans le panier : deux tarifs réels sont alors calculés, Mondial Relay (point relais) et Colissimo (domicile), en France et dans l'Union européenne. Pour le point relais, une carte vous permet de choisir le vôtre. Une date de livraison estimée s'affiche aussi dans le panier.</li>
        <li><strong>Emballage : 1,50 €.</strong> Ce forfait s'ajoute au tarif du transporteur. Votre commande part dans un seul carton, choisi à la bonne taille pour protéger vos pièces.</li>
        <li><strong>Retrait à l'atelier.</strong> Vous êtes près de Nantes ? Le retrait est gratuit à l'atelier, sur rendez-vous.</li>
      </ul>
      <p>Le prix de la pièce et celui de la livraison restent distincts : le prix affiché dans le devis est hors livraison, et les frais de port sont calculés séparément, à partir de votre adresse.</p>
    </GuideSection>

    <GuideSection id="prix-paye" title="Prix affiché = prix payé">
      <p>Le prix que vous voyez est celui que vous payez pour la pièce. Les prix sont affichés <strong>TTC</strong> : pas de prix hors taxe qui augmente au moment de payer. Seule la livraison s'ajoute, calculée dans le panier selon votre adresse, et elle est gratuite si vous retirez la pièce à l'atelier.</p>
      <p>Le paiement, lui, vient après l'expertise. <strong>Aucun paiement à la commande. Expertise et validation de votre pièce en amont.</strong></p>
      <ul>
        <li>Vous envoyez votre commande sans payer.</li>
        <li>Nous ouvrons votre fichier et vérifions l'épaisseur des parois, l'orientation, les supports et la matière choisie. Réponse sous 24 à 48 h.</li>
        <li>Une fois la commande acceptée, vous payez en ligne depuis votre compte client, de façon sécurisée (Stripe).</li>
      </ul>
      <p>Si votre pièce ne peut pas être imprimée telle quelle, nous vous le disons avant de fabriquer. Vous n'avez alors rien payé.</p>
    </GuideSection>

    <GuideSection id="prix-exact" title="Obtenir votre prix exact en quelques minutes">
      <ol>
        <li><strong>Ouvrez le <a href="/devis-instantane">devis instantané</a></strong> et déposez votre fichier STL, OBJ ou 3MF. Un fichier de CAO (STEP, SolidWorks, Fusion 360, FreeCAD…) s'exporte en STL ou en 3MF depuis votre logiciel.</li>
        <li><strong>Choisissez la matière, la couleur et la quantité</strong>, puis réglez la qualité et le remplissage si vous le souhaitez.</li>
        <li><strong>Patientez quelques minutes.</strong> Votre fichier est réellement tranché et le prix s'affiche, calculé sur votre pièce.</li>
        <li><strong>Ajoutez la pièce au panier et envoyez la commande, sans payer.</strong> Nous l'expertisons sous 24 à 48 h, puis vous payez une fois la commande acceptée.</li>
      </ol>
      <p><strong>Vous n'avez pas de fichier 3D ?</strong> Envoyez-nous des photos de la pièce, même cassée, avec ses dimensions principales via le <a href="/contact">formulaire de contact</a> : nous la redessinons en 3D, sur devis, avant de l'imprimer. Le guide <a href="/impression-3d-particuliers">impression 3D pour particuliers</a> détaille ce cas.</p>
      <p>Pour le parcours complet, de la commande à la livraison, voir le guide <a href="/impression-3d-en-ligne">impression 3D en ligne</a>.</p>
    </GuideSection>

    <GuideFaq items={faq} title="Questions fréquentes sur le prix de l'impression 3D" />

    <GuideCta primaryLabel="Calculer le prix de ma pièce" showSecondary={false} />

    <GuideRelated current={PATH} />
  </GuideArticle>
</BaseLayout>
