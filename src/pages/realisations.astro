---
import BaseLayout from "../layouts/BaseLayout.astro";

const ITEMS = [
  { img: "real-1.png", label: "Maquette ÄKTA readyflux", desc: "Reproduction détaillée d'un système de chromatographie, vue d'ensemble." },
  { img: "real-2.png", label: "ÄKTA readyflux — face avant", desc: "Panneau fluidique, vannes et tubulures fonctionnels à l'échelle." },
  { img: "real-3.png", label: "ÄKTA readyflux — vue 3/4", desc: "Châssis, tubulures et raccords fonctionnels à l'échelle." },
  { img: "real-4.jpg", label: "Trophée cerf", desc: "Découpe laser multi-couches en bois, montage mural." },
  { img: "real-5.jpg", label: "Caravanes Fendt miniatures", desc: "Série de modèles réduits imprimés et détaillés." },
  { img: "real-6.jpg", label: "Rondin gravé mariage", desc: "Gravure laser personnalisée sur tranche de bois." },
  { img: "real-7.jpg", label: "Médaille animal gravée", desc: "Gravure fibre sur médaille inox personnalisée." },
  { img: "real-8.jpg", label: "Maquette cellule — vue de face", desc: "Modèle pédagogique en coupe, pièces multicolores." },
  { img: "real-9.jpg", label: "Maquette cellule", desc: "Modèle pédagogique en coupe, pièces multicolores." },
  { img: "real-10.jpg", label: "Engrenage métal inox 316L", desc: "Impression 3D métal, engrenage technique en acier inoxydable 316L." },
  { img: "real-12.jpg", label: "Pièce rétro-conçue", desc: "Réducteur redessiné en CAO à partir de la pièce d'origine usée." },
  { img: "real-13.jpg", label: "Verres personnalisés", desc: "Gravure laser sur manchon cuir, personnalisation au prénom." },
  { img: "real-14.jpg", label: "Petite série technique", desc: "Pièce en TPU noir 90A, série de 528 unités." },
  { img: "real-15.jpg", label: "Formes pédagogiques", desc: "Pièces d'illustration multicolores pour le secteur santé." },
  { img: "real-16.jpg", label: "Figurines résine SLA", desc: "Impression résine haute définition prête pour peinture." },
  { img: "real-17.jpg", label: "Objets liturgiques", desc: "Maquettes de design produit pour une présentation" },
  { img: "real-18.jpg", label: "Cache Peugeot 102", desc: "Cache personnalisé imprimé pour Peugeot 102." },
  { img: "real-19.png", label: "Maquette bioréacteur — vue d'ensemble", desc: "Reproduction détaillée d'une cuve, tubulures et raccords." },
  { img: "real-20.png", label: "Maquette bioréacteur — vue de dessus", desc: "Vue du dessus de la maquette." },
  { img: "real-21.png", label: "Maquette bioréacteur — détail vannes", desc: "Bloc de vannes et manomètres imprimés avec stickers intégrés" },
];
---

<BaseLayout
  title="Réalisations — Projets d'Impression 3D | Nasap3D"
  description="Un aperçu des pièces, prototypes et projets réalisés par Nasap3D, atelier d'impression 3D à Nantes, pour ses clients particuliers et professionnels."
  path="/realisations"
>
  <div class="hero">
    <div class="kicker">Réalisations</div>
    <div class="hero-title">Un aperçu de ce qu'on fabrique</div>
    <div class="hero-intro">
      Prototypes, pièces de rétro-conception, interventions de maintenance — quelques exemples de projets menés à
      l'atelier.
    </div>
  </div>

  <div class="gallery">
    {
      ITEMS.map((it) => (
        <div class="gallery-card">
          <div class="gallery-photo" style={`background-image:url('/assets/${it.img}')`} />
          <div class="gallery-body">
            <div class="gallery-label">{it.label}</div>
            <div class="gallery-desc">{it.desc}</div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="cta-wrap">
    <div class="cta-box">
      <div class="cta-title">Un projet en tête ?</div>
      <div class="cta-text">Décrivez-le nous, ou lancez directement un devis instantané si votre fichier est prêt.</div>
      <a href="/contact" class="cta-link">Nous contacter</a>
    </div>
  </div>
</BaseLayout>

<style>
  .hero,
  .gallery,
  .cta-wrap {
    max-width: 1000px;
    margin: 0 auto;
  }
  .hero {
    padding: 56px 24px 30px;
  }
  .kicker {
    font: 600 12px "Inter", sans-serif;
    letter-spacing: 1.2px;
    color: #ff5a3c;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .hero-title {
    font: 700 30px/1.15 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 10px;
  }
  .hero-intro {
    font: 400 13px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    max-width: 560px;
  }
  .gallery {
    padding: 0 24px 56px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gallery-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    background: #1a1917;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .gallery-card:hover {
    border-color: #ff5a3c;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
    transform: translateY(-3px);
  }
  .gallery-photo {
    aspect-ratio: 4 / 5;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .gallery-body {
    padding: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .gallery-label {
    font: 600 12.5px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 4px;
  }
  .gallery-desc {
    font: 400 10.5px/1.5 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.5);
  }
  .cta-wrap {
    padding: 0 24px 56px;
    text-align: center;
  }
  .cta-box {
    border: 1px solid rgba(255, 90, 60, 0.3);
    background: rgba(255, 90, 60, 0.08);
    border-radius: 12px;
    padding: 28px;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .cta-box:hover {
    border-color: #ff5a3c;
    transform: scale(1.02);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
  }
  .cta-title {
    font: 700 17px "Space Grotesk", sans-serif;
    color: #f3f1ec;
    margin-bottom: 6px;
  }
  .cta-text {
    font: 400 11.5px/1.6 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 14px;
  }
  .cta-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    font: 600 11px "Inter", sans-serif;
    color: #ff5a3c;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    transition:
      padding 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }
  .cta-box:hover .cta-link {
    padding: 6px 12px;
    border-color: #ff5a3c;
    background: rgba(255, 90, 60, 0.1);
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 420px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
