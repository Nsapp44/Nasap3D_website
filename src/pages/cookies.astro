---
import LegalLayout from "../layouts/LegalLayout.astro";
---

<LegalLayout
  path="/cookies"
  title="Politique de cookies | Nasap3D"
  description="Politique de cookies du site Nasap3D."
  pageTitle="Politique de cookies"
  sections={[
    {
      heading: "Qu'est-ce qu'un cookie ?",
      body: "Un cookie est un petit fichier stocké sur votre appareil lors de la navigation sur le site, permettant de mémoriser certaines informations (préférences, connexion, panier).",
    },
    {
      heading: "Cookies utilisés",
      body: "Nasap3D utilise des cookies strictement nécessaires au fonctionnement du site (session de connexion, contenu du panier) ainsi que, le cas échéant, des cookies de mesure d'audience.",
    },
    {
      heading: "Gestion des cookies",
      body: "Vous pouvez à tout moment configurer votre navigateur pour refuser les cookies. Le refus des cookies essentiels peut toutefois affecter le bon fonctionnement du site (connexion, panier).",
    },
    {
      heading: "Durée de conservation",
      body: "Les cookies sont conservés pour une durée maximale de 13 mois, conformément aux recommandations de la CNIL.",
    },
  ]}
/>
