---
interface Props {
  style?: string;
}
const { style } = Astro.props;
const steps = [
  { n: "1", title: "Votre devis instantané", text: "Prix calculé sur votre fichier, en quelques minutes." },
  { n: "2", title: "Expertise humaine", text: "Nous vérifions votre pièce à la main avant tout paiement.", hl: true },
  { n: "3", title: "Paiement après validation", text: "Vous payez uniquement une fois la commande acceptée." },
];
---
<div class="es" style={style}>
  <p class="es-head">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.75 2.75 3.9v3.7c0 3 2.1 5.2 5.25 6.65 3.15-1.45 5.25-3.65 5.25-6.65V3.9z"/><path d="m5.9 8 1.5 1.5 2.7-2.9"/></svg>
    <span>Aucun paiement à la commande : <strong>un humain valide d'abord votre pièce</strong>.</span>
  </p>
  <ol class="es-steps" role="list">
    {steps.map((s) => (
      <li class:list={["es-step", { "es-step--hl": s.hl }]}>
        <span class="es-n" aria-hidden="true">{s.n}</span>
        <span class="es-body">
          <span class="es-title">{s.title}</span>
          <span class="es-text">{s.text}</span>
        </span>
      </li>
    ))}
  </ol>
</div>
<style>
  .es { max-width: 600px; width: 100%; font-family: "Inter", sans-serif; color: #e7e3dd;
        animation: es-in 0.5s 0.3s ease-out both; }
  .es-head { margin: 0 0 10px; display: flex; gap: 9px; align-items: flex-start;
        font: 400 13px/1.5 "Inter", sans-serif; color: #e7e3dd; }
  .es-head svg { flex: none; width: 16px; height: 16px; margin-top: 2px; color: #ff7a5f; }
  .es-head strong { font-weight: 600; color: #f3f1ec; }
  .es-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .es-step { display: flex; gap: 11px; align-items: flex-start; padding: 11px 14px; border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1); background: #1a1917; }
  .es-step--hl { border-color: rgba(255, 90, 60, 0.38); background-color: #201d1b;
        background-image: linear-gradient(135deg, rgba(255, 90, 60, 0.14), rgba(255, 90, 60, 0.03) 60%); }
  .es-n { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;
        font: 700 12px/1 "Space Grotesk", sans-serif; color: #161514; background: rgba(255, 255, 255, 0.4); }
  .es-step--hl .es-n { background: #ff5a3c; }
  .es-body { display: flex; flex-direction: column; gap: 2px; }
  .es-title { font: 600 13px/1.3 "Space Grotesk", sans-serif; color: #f3f1ec; }
  .es-text { font: 400 12px/1.5 "Inter", sans-serif; color: rgba(255, 255, 255, 0.6); }
  @media (min-width: 720px) {
    .es { max-width: 1000px; }
    .es-steps { grid-template-columns: repeat(3, 1fr); gap: 12px; }
  }
  @keyframes es-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .es { animation: none; } }
</style>
