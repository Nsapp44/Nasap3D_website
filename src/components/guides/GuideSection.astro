---
/**
 * GuideSection : section d'un guide (h2 + prose). Fournit les styles de lecture du contenu passé en slot
 * (p, ul, ol, strong, liens, h3) : ~70 caractères par ligne, listes à puces accent.
 *
 * Props :
 *  - id: string      ancre de la section (cible du sommaire), ex. "cout" ; le h2 reçoit l'id "<id>-titre"
 *  - title: string   texte du h2
 *
 * Classes utilitaires utilisables dans le slot : .gmore (paragraphe d'un lien isolé, cible tactile 44 px).
 */
import { fr } from "../../lib/typo";

interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<section class="gsec" id={id} aria-labelledby={`${id}-titre`}>
  <h2 id={`${id}-titre`}>{fr(title)}</h2>
  <slot />
</section>
<style>
  .gsec { margin-top: 38px; scroll-margin-top: 72px; animation: gsec-in 0.5s ease-out both; }
  .gsec > h2 { margin: 0 0 14px; font: 600 21px/1.2 "Space Grotesk", sans-serif; letter-spacing: -0.01em; color: #f3f1ec; text-wrap: balance; }
  .gsec :global(h3) { margin: 18px 0 6px; font: 600 16.5px/1.25 "Space Grotesk", sans-serif; color: #f3f1ec; text-wrap: balance; }
  .gsec :global(p) { margin: 0 0 12px; max-width: 70ch; color: rgba(255, 255, 255, 0.78); text-wrap: pretty; }
  .gsec :global(ul),
  .gsec :global(ol) { margin: 0 0 12px; padding-left: 20px; max-width: 70ch; color: rgba(255, 255, 255, 0.78); }
  .gsec :global(li) { margin: 6px 0; }
  .gsec :global(li::marker) { color: #ff5a3c; }
  .gsec :global(strong) { color: #f3f1ec; font-weight: 600; }
  .gsec :global(a) { color: #ff5a3c; font-weight: 500; text-decoration: underline; text-underline-offset: 3px; }
  .gsec :global(a:hover) { color: #ff7a5c; }
  .gsec :global(a:focus-visible) { outline: 2px solid #ff5a3c; outline-offset: 2px; border-radius: 3px; }
  .gsec :global(.gmore a) { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 640px) { .gsec > h2 { font-size: 25px; } }
  @keyframes gsec-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .gsec { animation: none; } }
</style>
