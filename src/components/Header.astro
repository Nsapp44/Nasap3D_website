---
import NavAuthIcon from "./NavAuthIcon";
import QuoteNavLink from "./QuoteNavLink";
import CartBadge from "./CartBadge";

interface Props {
  currentPath: string;
  // Nantes/Cholet/Angers n'avaient pas l'icône réglages dans l'ancien
  // framework — écart volontairement préservé. Le badge du panier, lui,
  // doit rester visible partout (signalé comme un vrai oubli, pas une
  // différence voulue) — voir cart-count plus bas, non lié à cette prop.
  showAuthIcon?: boolean;
}
const { currentPath, showAuthIcon = true } = Astro.props;
// Le panier n'est pas dans NAV_ITEMS (c'est une icône, pas un lien texte) —
// sur /panier, l'original le marquait "page actuelle" (soulignement rouge)
// directement sur l'icône plutôt que sur un lien de la nav.
const cartIsCurrent = currentPath === "/panier";

// "Devis instantané" est rendu à part (voir QuoteNavLink) : c'est le seul
// lien qui doit disparaître quand le devis est en pause, donc le seul qui a
// besoin d'être un îlot client — les autres restent du HTML statique.
const NAV_ITEMS = [
  { href: "/", label: "Accueil" },
  { href: "/services", label: "Services" },
  { href: "/a-propos", label: "À propos" },
  { href: "/realisations", label: "Réalisations" },
  { href: "/machines", label: "Machines" },
  { href: "/contact", label: "Contact" },
];
const DEVIS_INDEX = 2; // position d'origine de "Devis instantané" dans la nav

// Menu "Guides" : mini déroulant sur ordinateur, groupe de liens dans le menu
// burger sur mobile. Inséré juste avant "Contact" (voir GUIDES_INDEX).
// `short` = libellé court du menu mobile. Même liste dans HomeHeader.tsx.
const GUIDES = [
  { href: "/impression-3d-en-ligne", title: "Impression 3D en ligne", sub: "Commander depuis toute la France", short: "Impression 3D en ligne" },
  { href: "/impression-3d-particuliers", title: "Impression 3D pour particuliers", sub: "Même sans fichier 3D", short: "Pour particuliers" },
  { href: "/prix-impression-3d", title: "Prix de l'impression 3D", sub: "Comment le prix est calculé, exemples", short: "Prix" },
  { href: "/materiaux-impression-3d", title: "Matériaux d'impression 3D", sub: "PLA, PETG, TPU, ABS…", short: "Matériaux" },
];
const GUIDES_INDEX = 5; // position de "Contact" dans NAV_ITEMS
const guidesIsCurrent = GUIDES.some((g) => g.href === currentPath);
---

<div class="site-header">
  <a href="/" class="logo-link">
    <img src="/assets/logo-blanc-full.png" alt="Nasap3D" class="logo-img" />
  </a>

  <div class="nav-links">
    {
      NAV_ITEMS.slice(0, DEVIS_INDEX).map((item) =>
        item.href === currentPath ? (
          <span class="nav-current nav-hover-scale">{item.label}</span>
        ) : (
          <a href={item.href} class="nav-hover-scale">
            {item.label}
          </a>
        ),
      )
    }
    {
      currentPath === "/maquettiste-nantes" ? (
        <span class="nav-current nav-hover-scale">Maquettes</span>
      ) : (
        <a href="/maquettiste-nantes" class="nav-hover-scale">
          Maquettes
        </a>
      )
    }
    <QuoteNavLink isCurrent={currentPath === "/devis-instantane"} client:load />
    {
      NAV_ITEMS.slice(DEVIS_INDEX, GUIDES_INDEX).map((item) =>
        item.href === currentPath ? (
          <span class="nav-current nav-hover-scale">{item.label}</span>
        ) : (
          <a href={item.href} class="nav-hover-scale">
            {item.label}
          </a>
        ),
      )
    }
    <div class="nav-guides" data-guides>
      <button
        type="button"
        class={`nav-guides-btn nav-hover-scale${guidesIsCurrent ? " nav-current" : ""}`}
        aria-expanded="false"
        aria-controls="guides-menu"
      >
        Guides
        <svg class="guides-chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="guides-menu" id="guides-menu">
        <ul class="guides-list" aria-label="Guides">
          {
            GUIDES.map((g) => (
              <li>
                <a
                  href={g.href}
                  class={`g-link${g.href === currentPath ? " is-current" : ""}`}
                  aria-current={g.href === currentPath ? "page" : undefined}
                >
                  <b class="g-t">{g.title}</b>
                  <small class="g-s">{g.sub}</small>
                  <i class="g-m">{g.short}</i>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    {
      NAV_ITEMS.slice(GUIDES_INDEX).map((item) =>
        item.href === currentPath ? (
          <span class="nav-current nav-hover-scale">{item.label}</span>
        ) : (
          <a href={item.href} class="nav-hover-scale">
            {item.label}
          </a>
        ),
      )
    }
  </div>

  <div class="header-account">
    <a href="/compte" class="nav-hover-scale">Compte</a>
    {showAuthIcon && <NavAuthIcon client:load />}
    <a href="/panier" class={`cart-link${cartIsCurrent ? " cart-current" : ""}`}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="8" cy="21" r="1"></circle>
        <circle cx="19" cy="21" r="1"></circle>
        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
      </svg>
      <CartBadge client:load />
    </a>
  </div>

</div>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-img {
    height: 34px;
    width: auto;
  }
  .nav-links {
    display: flex;
    gap: clamp(16px, calc((100vw - 920px) / 8), 26px);
    font: 500 13px "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.62);
  }
  .nav-links a {
    text-decoration: none;
    color: inherit;
  }
  /* Bouton "Guides" : rendu comme les liens voisins (reset du bouton ; placé
     avant .nav-current pour que celui-ci puisse remettre sa bordure). */
  .nav-guides-btn {
    appearance: none;
    background: none;
    border: 0;
    margin: 0;
    padding: 0;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }
  .nav-guides-btn:focus-visible {
    outline: 2px solid #ff5a3c;
    outline-offset: 6px;
    border-radius: 4px;
  }
  .nav-current {
    color: #f3f1ec;
    border-bottom: 2px solid #ff5a3c;
    padding-bottom: 4px;
  }
  /* Menu déroulant "Guides" (ordinateur) : ouvert au survol, au focus clavier
     et au clic/tap (classe .is-open posée par le script ci-dessous ;
     .is-closed = fermé volontairement par Échap / second clic). */
  .nav-guides {
    position: relative;
  }
  .guides-chevron,
  .g-m {
    display: none;
  }
  .guides-menu {
    position: absolute;
    top: 100%;
    right: -14px; /* ancré à droite : un panneau masqué déborde vers la gauche, jamais de scroll horizontal */
    padding-top: 12px;
    z-index: 60;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }
  .nav-guides:not(.is-closed):hover .guides-menu,
  .nav-guides:not(.is-closed):focus-within .guides-menu,
  .nav-guides.is-open .guides-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s;
  }
  .guides-menu .guides-list {
    list-style: none;
    margin: 0;
    padding: 8px;
    width: 340px;
    max-width: calc(100vw - 32px);
    box-sizing: border-box;
    background: #201d1b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.45);
  }
  .guides-menu .g-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    padding: 9px 12px;
    border-radius: 8px;
    text-decoration: none;
  }
  .guides-menu .g-t {
    display: block;
    font: 600 14px/1.3 "Space Grotesk", sans-serif;
    color: #f3f1ec;
    transition: color 0.2s ease;
  }
  .guides-menu .g-s {
    display: block;
    margin-top: 2px;
    font: 400 12.5px/1.35 "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.55);
  }
  .guides-menu .g-link:hover,
  .guides-menu .g-link:focus-visible {
    background: rgba(255, 255, 255, 0.04);
  }
  .guides-menu .g-link:hover .g-t,
  .guides-menu .g-link:focus-visible .g-t,
  .guides-menu .g-link.is-current .g-t {
    color: #ff5a3c;
  }
  .guides-menu .g-link:focus-visible {
    outline: 2px solid #ff5a3c;
    outline-offset: -2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .guides-menu,
    .nav-guides:not(.is-closed):hover .guides-menu,
    .nav-guides:not(.is-closed):focus-within .guides-menu,
    .nav-guides.is-open .guides-menu,
    .guides-menu .g-t {
      transition: none;
    }
    .guides-menu {
      transform: none;
    }
  }
  .header-account {
    display: flex;
    align-items: center;
    gap: 18px;
    font: 500 12px "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.75);
  }
  .header-account a {
    text-decoration: none;
    color: inherit;
  }
  .cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .cart-current {
    color: #f3f1ec;
    border-bottom: 2px solid #ff5a3c;
    padding-bottom: 4px;
  }
  /* :global() : le badge est rendu par CartBadge (îlot client:load),
     enveloppé dans son propre <astro-island> — hors de la frontière du CSS
     scopé de ce fichier (même classe de bug que QuoteNavLink, voir plus bas). */
  .cart-link :global(.cart-count) {
    position: absolute;
    top: -9px;
    right: -9px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #ff5a3c;
    color: #161514;
    font: 700 8.5px/15px "Inter", sans-serif;
    text-align: center;
  }

  /* <=1060px (seuil commun avec global.css et HomeHeader.tsx) : la rangée de liens devient un panneau déroulant sous le
     header, ouvert/fermé par MobileNavToggle (voir ce composant) — même
     comportement que l'ancien responsive.css, en classes réelles plutôt
     qu'en sélecteurs d'attribut [style*="..."] (qui n'ont plus de raison
     d'être : ce n'est plus le framework DC qui rend tout en style inline). */
  @media (max-width: 1060px) {
    .site-header {
      padding: 12px 90px 12px 16px;
      position: relative;
    }
    .header-account {
      gap: 22px;
    }
    .nav-links {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: #161514;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transform: scale(0.94);
      transform-origin: top center;
      transition:
        max-height 0.28s ease,
        opacity 0.22s ease,
        transform 0.22s ease;
      padding: 0 16px;
      z-index: 50;
    }
    :global(html.nasap-nav-open) .nav-links {
      max-height: 760px;
      overflow-x: hidden;
      overflow-y: auto;
      opacity: 1;
      transform: scale(1);
      padding: 8px 16px 14px;
    }
    /* Descendant (pas enfant direct) : QuoteNavLink est un îlot client,
       Astro l'enveloppe dans son propre élément (astro-island) — un
       sélecteur ">" ne l'atteint pas, ce qui laissait son survol/tap
       zoomer comme sur desktop au lieu de rester figé comme les autres
       liens du menu mobile. */
    .nav-links :global(a),
    .nav-links :global(span) {
      display: block;
      width: 100%;
      padding: 12px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      transition: none;
      transform: none;
    }
    .nav-links :global(a:hover),
    .nav-links :global(span:hover) {
      transform: none;
    }
    .nav-current {
      font-weight: 700;
      padding: 12px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      text-decoration: underline;
      text-decoration-color: rgb(255, 90, 60);
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
    /* "Guides" sur mobile : accordéon. Le bouton (ligne + chevron) ouvre /
       replie les 4 liens ; fermé par défaut (script : .is-open). */
    .nav-links .nav-guides-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 44px;
      box-sizing: border-box;
      padding: 12px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      color: inherit;
      text-align: left;
      transform: none;
      transition: none;
    }
    .nav-links .nav-guides-btn:hover {
      transform: none;
    }
    .nav-links .guides-chevron {
      display: block;
      flex: none;
      transition: transform 0.25s ease;
    }
    .nav-links .nav-guides.is-open .guides-chevron {
      transform: rotate(180deg);
    }
    .nav-links .guides-menu {
      position: static;
      display: grid;
      grid-template-rows: 0fr;
      padding: 0;
      opacity: 1;
      visibility: hidden;
      transform: none;
      transition:
        grid-template-rows 0.28s ease,
        visibility 0s linear 0.28s;
    }
    /* Le survol/focus (règles ordinateur) ne doit rien ouvrir sur mobile. */
    .nav-links .nav-guides:not(.is-open) .guides-menu {
      opacity: 1;
      visibility: hidden;
      transform: none;
    }
    .nav-links .nav-guides.is-open .guides-menu {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows 0.28s ease,
        visibility 0s;
    }
    @media (prefers-reduced-motion: reduce) {
      .nav-links .guides-menu,
      .nav-links .nav-guides.is-open .guides-menu,
      .nav-links .guides-chevron {
        transition: none;
      }
    }
    .nav-links .guides-menu .guides-list {
      min-height: 0;
      overflow: hidden;
      width: auto;
      max-width: none;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .nav-links .guides-menu .g-link {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      min-height: 0;
      box-sizing: border-box;
      width: calc(100% + 8px);
      padding: 12px 4px 12px 18px;
      border-radius: 0;
      background: none;
    }
    .nav-links .guides-menu .g-t,
    .nav-links .guides-menu .g-s {
      display: none;
    }
    .nav-links .guides-menu .g-m {
      display: inline;
      font-style: normal;
    }
    .nav-links .guides-menu .g-link.is-current {
      color: #f3f1ec;
    }
    .nav-links .guides-menu .g-link.is-current .g-m {
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: rgb(255, 90, 60);
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }
</style>

<script>
  // Menu "Guides" (ordinateur) : le CSS l'ouvre déjà au survol et au focus
  // clavier ; ce script ajoute le clic/tap (.is-open + aria-expanded), la
  // fermeture sur Échap, second clic et clic extérieur (.is-closed masque le
  // panneau malgré le survol/focus restant). Sans effet sur mobile (accordéon, voir plus bas).
  const root = document.querySelector<HTMLElement>("[data-guides]");
  const btn = root && root.querySelector<HTMLButtonElement>(".nav-guides-btn");
  if (root && btn) {
    const setOpen = (open: boolean) => {
      root.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    const dismiss = () => {
      setOpen(false);
      root.classList.add("is-closed");
    };
    const isShown = () =>
      root.classList.contains("is-open") || root.matches(":hover") || root.matches(":focus-within");

    // Mobile (même seuil que le burger) : accordéon, ouvert/replié au clic
    // uniquement ; les gestionnaires "ordinateur" ci-dessous sont ignorés.
    const mobile = window.matchMedia("(max-width: 1060px)");
    if (mobile.matches && root.querySelector(".g-link.is-current")) setOpen(true);
    mobile.addEventListener("change", () =>
      setOpen(mobile.matches && !!root.querySelector(".g-link.is-current")),
    );

    btn.addEventListener("click", () => {
      if (mobile.matches) {
        setOpen(!root.classList.contains("is-open"));
        return;
      }
      if (root.classList.contains("is-open")) dismiss();
      else {
        root.classList.remove("is-closed");
        setOpen(true);
      }
    });
    root.addEventListener("mouseenter", () => root.classList.remove("is-closed"));
    root.addEventListener("mouseleave", () => {
      if (mobile.matches) return;
      setOpen(false);
      root.classList.remove("is-closed");
      // Un clic souris laisse le focus sur le bouton : on le retire pour que
      // :focus-within ne garde pas le panneau ouvert (le focus clavier reste).
      const f = document.activeElement;
      if (f instanceof HTMLElement && root.contains(f) && !f.matches(":focus-visible")) f.blur();
    });
    root.addEventListener("focusout", (e) => {
      if (mobile.matches) return;
      if (e.relatedTarget && !root.contains(e.relatedTarget as Node)) {
        setOpen(false);
        root.classList.remove("is-closed");
      }
    });
    document.addEventListener("click", (e) => {
      if (mobile.matches) return;
      if (!root.contains(e.target as Node) && root.classList.contains("is-open")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (mobile.matches || e.key !== "Escape" || !isShown()) return;
      const hadFocus = root.contains(document.activeElement);
      dismiss();
      if (hadFocus) btn.focus();
    });
  }
</script>
