    }, { passive: false });
    resetBtn.addEventListener("click", () => {
      if (!V) return;
      V.az = 0; V.elF = V.item.startEl; V.vaz = 0; V.auto = !reduce; V.dirty = true; setZoom(1); kick();
    });
    stage.addEventListener("keydown", (e) => {
      if (!V || !V.ready) return;
      const step = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key];
      if (step) {
        e.preventDefault(); touched();
        V.az += step[0]; V.elF = clamp(Math.round(V.elF) + step[1], 0, V.item.elevs.length - 1); V.vaz = 0;
      } else if (e.key === "+" || e.key === "=") setZoom(zoom + 0.2);
      else if (e.key === "-") setZoom(zoom - 0.2);
      else return;
      V.dirty = true; kick();
    });

    // ---- Changement de maquette ----
    function mount(i) {
      const m = items[i];
      if (m.soon) { // slide « À venir » : rien à charger, pas de canvas
        V = null; setZoom(1); msg.hidden = true;
        soonEl.querySelector(".mq-soon-title").textContent = m.title;
        soonEl.hidden = false;
        poster.classList.add("off"); cv.classList.remove("on"); loader.hidden = true;
        resetBtn.hidden = true; hint.hidden = true;
        return;
      }
      soonEl.hidden = true;
      let v = views.get(i);
      if (!v) { v = newView(m); views.set(i, v); }
      V = v;
      poster.removeAttribute("src"); poster.dataset.src = m.posterWebp; poster.alt = m.posterAlt; stage.classList.remove("fail");
      cv.setAttribute("aria-label", `${m.title} : vue à 360°. Flèches du clavier ou glisser pour tourner, molette ou pincement pour zoomer.`);
      msg.hidden = true; setZoom(1);
      cv.classList.remove("on"); poster.classList.remove("off"); loader.hidden = false;
      if (onScreen) startLoading(v);
      if (v.ready) shown();
      else if (v.failed) fail(v);
    }
    async function go(to) {
      if (!multi || busy) return;
      to = (to + items.length) % items.length;
      if (to === idx) return;
      const dir = to > idx || (idx === items.length - 1 && to === 0) ? 1 : -1;
      busy = true;
      idx = to;
      paintMeta();
      track("maquette_3d_next", { id: items[idx].id });
      stage.style.setProperty("--dir", dir);
      stage.classList.add("is-swap");
      await new Promise((r) => setTimeout(r, reduce ? 0 : 260));
      mount(idx);
      stage.classList.remove("is-swap");
      busy = false;
    }
    prevBtn.addEventListener("click", () => go(idx - 1));
    nextBtn.addEventListener("click", () => go(idx + 1));

    // Swipe horizontal sur la poignée (hors zone de rotation).
    let sx = null;
    grip.addEventListener("pointerdown", (e) => { sx = e.clientX; grip.setPointerCapture(e.pointerId); grip.classList.add("drag"); });
    const endSwipe = (e) => {
      if (sx === null) return;
      const dx = e.clientX - sx; sx = null; grip.classList.remove("drag");
      if (Math.abs(dx) > 40) go(dx < 0 ? idx + 1 : idx - 1);
    };
    grip.addEventListener("pointerup", endSwipe);
    grip.addEventListener("pointercancel", () => { sx = null; grip.classList.remove("drag"); });

    // Chargement paresseux : rien n'est téléchargé avant que la section approche de l'écran.
    new ResizeObserver(resize).observe(stage);
    new IntersectionObserver((es) => {
      onScreen = es[0].isIntersecting;
      if (onScreen && V) { startLoading(V); if (V.ready) { V.dirty = true; kick(); } }
    }, { rootMargin: "500px 0px", threshold: 0 }).observe(stage);
    document.addEventListener("visibilitychange", () => { lastTs = 0; kick(); });
    mount(idx);
    window.__mq = { go: (i) => go(i), get ready() { return !!(V && V.ready); } };
  })();
</script>

