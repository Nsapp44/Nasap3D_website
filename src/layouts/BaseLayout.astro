---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileNavToggle from "../components/MobileNavToggle";

interface Props {
  title: string;
  description: string;
  path: string;
  showAuthIcon?: boolean;
  noindex?: boolean;
  hideFooter?: boolean;
}
const { title, description, path, showAuthIcon, noindex = false, hideFooter = false } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="page-shell">
      <MobileNavToggle client:load />
      <Header currentPath={path} showAuthIcon={showAuthIcon} />
      <slot />
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>

<style>
  .page-shell {
    background: #161514;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>
