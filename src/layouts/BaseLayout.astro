---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileNavToggle from "../components/MobileNavToggle";

interface Props {
  title: string;
  description: string;
  path: string;
  showAuthIcon?: boolean;
  noindex?: boolean;
  hideFooter?: boolean;
  hideHeader?: boolean;
}
const { title, description, path, showAuthIcon, noindex = false, hideFooter = false, hideHeader = false } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/assets/logo-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <script is:inline>
      // Every page is static HTML (output: 'static', no per-request SSR) —
      // it always bakes in the optimistic "quote enabled" default for
      // anything gated by useQuoteEnabled, since sessionStorage doesn't
      // exist at build time. When the flag is actually paused, that static
      // markup is visibly wrong for the split-second between first paint
      // and the React island hydrating and correcting it — worse than a
      // typical hydration flash because it reads as "it works, then it
      // doesn't" rather than a neutral loading state. This runs before the
      // body is even parsed (classic flash-of-wrong-theme pattern) and
      // hides anything marked .n3d-quote-gate immediately if the last known
      // value (see useQuoteEnabled) says paused — React's own hydration
      // then renders the same correct state, so there's nothing to
      // reconcile. A first-ever visit (no cached value yet) still shows the
      // optimistic default for one page, same trade-off as before.
      try {
        if (sessionStorage.getItem("nasap3d-quote-enabled") === "false") {
          document.documentElement.classList.add("n3d-quote-paused");
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class={`page-shell${hideFooter ? " page-shell-flex" : ""}`}>
      <MobileNavToggle client:load />
      {!hideHeader && <Header currentPath={path} showAuthIcon={showAuthIcon} />}
      <slot />
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>

<style>
  .page-shell {
    background: #161514;
    min-height: 100vh;
  }
  /* Réservé aux pages avec footer custom (404) qui ont besoin d'un vrai
     flex column pour coller leur propre footer en bas — appliqué seulement
     via hideFooter pour ne jamais affecter la largeur du contenu des
     autres pages (un bug réel : le passer en global cassait max-width +
     margin:auto sur toutes les pages, voir historique de commit). */
  .page-shell-flex {
    display: flex;
    flex-direction: column;
  }
</style>
