---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileNavToggle from "../components/MobileNavToggle";

interface Props {
  title: string;
  description: string;
  path: string;
  showAuthIcon?: boolean;
  noindex?: boolean;
  hideFooter?: boolean;
  hideHeader?: boolean;
}
const { title, description, path, showAuthIcon, noindex = false, hideFooter = false, hideHeader = false } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs synchronously before anything below paints — see the
      // .n3d-quote-gate rules in global.css for why this exists. Reads the
      // exact same sessionStorage key as useQuoteEnabledCached (hooks/
      // useQuoteEnabled.ts): if a previous real check on Home/devis-
      // instantane already found the workshop paused, this hides the
      // "Devis instantané" nav link/CTA before the very first frame instead
      // of showing it and yanking it away once React hydrates.
      (function () {
        try {
          if (sessionStorage.getItem("nasap3d-quote-enabled") === "false") {
            document.documentElement.classList.add("n3d-quote-paused");
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/assets/logo-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class={`page-shell${hideFooter ? " page-shell-flex" : ""}`}>
      <MobileNavToggle client:load />
      {!hideHeader && <Header currentPath={path} showAuthIcon={showAuthIcon} />}
      <slot />
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>

<style>
  .page-shell {
    background: #161514;
    min-height: 100vh;
  }
  /* Réservé aux pages avec footer custom (404) qui ont besoin d'un vrai
     flex column pour coller leur propre footer en bas — appliqué seulement
     via hideFooter pour ne jamais affecter la largeur du contenu des
     autres pages (un bug réel : le passer en global cassait max-width +
     margin:auto sur toutes les pages, voir historique de commit). */
  .page-shell-flex {
    display: flex;
    flex-direction: column;
  }
</style>
