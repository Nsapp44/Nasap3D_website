# Copy to .env and fill in real values. Never commit .env.
#
# Pas besoin de guillemets autour des valeurs ci-dessous — et ne pas en
# mettre : ce fichier est chargé par `dotenv`, aussi bien pour `npm run dev`
# en local que pour le déploiement Docker (bind-mount + `import
# "dotenv/config"`, voir docker-compose.yml et server-entry.mjs), et `dotenv`
# les garderait telles quelles plutôt que de les retirer. Un
# `S3_REGION="eu-west-1"` avec guillemets deviendrait littéralement la chaîne
# `"eu-west-1"` (guillemets inclus), ce qui plante — vécu en prod, voir
# l'erreur AWS SDK "is not a valid hostname component". bootstrap/
# sanitizeEnv.mjs nettoie ça au démarrage en filet de sécurité, mais autant
# partir propre.

# --- Postgres (lu directement par docker-compose.yml pour le service "db") ---
# Le défaut codé dans docker-compose.yml (nasap3d_dev_only) est public — à ne
# JAMAIS utiliser sur un serveur avec une IP joignable depuis Internet.
# Générer un vrai secret, par exemple : openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Database (matches docker-compose.yml's "db" service for local dev) ---
# En déploiement Docker (docker-compose.yml, profil "full"), cette valeur
# est IGNORÉE : le service "api" impose sa propre DATABASE_URL construite à
# partir de POSTGRES_PASSWORD ci-dessus — celle-ci ne sert que pour
# `npm run dev` en dehors de Docker.
DATABASE_URL=postgresql://nasap3d:nasap3d_dev_only@localhost:5432/nasap3d

# --- Server ---
PORT=3000
# En déploiement Docker (profil "full"), cette valeur est IGNORÉE elle
# aussi : docker-compose.yml impose NODE_ENV=production au service "api"
# quoi qu'il arrive (voir son commentaire) — "development" ici ne sert que
# pour `npm run dev` en dehors de Docker.
NODE_ENV=development
# Base URL of the site, used to build links in emails (password reset, the
# admin contact-attachment download link, Stripe redirect URLs, ...) — same
# origin for front and API since the SSR migration, so this one variable
# covers what used to be FRONT_URL + API_BASE_URL separately.
FRONT_URL=http://localhost:3000
# Where contact-form submissions are notified
CONTACT_NOTIFY_EMAIL=nasap3D@gmail.com
# Where new-order notifications are sent (after Stripe payment confirms)
ORDER_NOTIFY_EMAIL=nasap3D@gmail.com

# --- Transactional email (account verification, password reset) — SMTP.
# Without these, emails are just logged to the console (see src/lib/server/mailer.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=no-reply@nasap3d.com
SMTP_PASSWORD=
MAIL_FROM=Nasap3D <no-reply@nasap3d.com>
# Set to "true" to log the full SMTP conversation (connect, EHLO, AUTH, and
# the mail server's own response text) as JSON, visible in `docker compose
# logs api`. Safe to leave on — off by default only because it's verbose.
SMTP_DEBUG=false

# --- Seed (prisma/seed.ts) ---
# Only used the FIRST time the admin/test accounts are created (the seed is
# idempotent — an already-existing account is left untouched, password
# included). Set these on any server reachable from the Internet: without
# SEED_ADMIN_PASSWORD, the seed falls back to a fixed dev-only password that
# lives in this public repo's source (see prisma/seed.ts) — fine for a local
# Docker reinstall, not fine for prod.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Auth ---
# Argon2id parameters (memory in KiB). Raise on production hardware.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- hCaptcha --- see README.md for how to obtain these
# La clé "site key" (publique) N'EST PAS ICI : elle est codée en dur dans
# src/lib/api-client.ts (HCAPTCHA_SITE_KEY), lue par le front-end qui n'a
# aucun accès à ce .env — la changer ici ne fait rien. Seule la clé secrète
# ci-dessous est réellement lue par le serveur.
HCAPTCHA_SECRET_KEY=

# --- Devis instantané (Kiri:Moto) ---
# Aucune variable d'environnement nécessaire ici : le tranchage tourne
# principalement dans le navigateur du visiteur (fichiers statiques, voir
# public/vendor/kiri/), et le filet de secours serveur (rare — voir
# src/lib/server/kiriSlicer.ts) utilise le moteur Kiri:Moto vendorisé
# directement dans l'image Docker (vendor/grid-apps/, voir le Dockerfile) —
# pas de binaire externe à configurer, contrairement à l'ancien
# PRUSASLICER_BIN (supprimé).

# --- Livraison : Boxtal (agrégateur multi-transporteurs) --- see SHIPPING.md
# Vide = hôte de production (https://www.envoimoinscher.com/). Pour tester
# sans facturer le compte réel, avec des identifiants sandbox V1 :
# BOXTAL_BASE_URL=https://test.envoimoinscher.com/
BOXTAL_BASE_URL=
BOXTAL_API_KEY_V1=
BOXTAL_API_SECRET_V1=
# Composant "carte" Boxtal (widget point relais, embarqué côté front au
# checkout) — les deux servent à obtenir un token temporaire côté serveur
# (POST https://api.boxtal.com/iam/account-app/token, Basic Auth), jamais
# envoyés tels quels au navigateur. Voir SHIPPING.md.
BOXTAL_MAP_API_KEY=
BOXTAL_MAP_API_SECRET=
# Adresse de départ des colis
BOXTAL_SHIPPER_COUNTRY=FR
BOXTAL_SHIPPER_ZIPCODE=
BOXTAL_SHIPPER_CITY=
BOXTAL_SHIPPER_ADDRESS=
# Only needed for a real label purchase (api/v1/order), not for rate quotes
BOXTAL_SHIPPER_FIRSTNAME=
BOXTAL_SHIPPER_LASTNAME=
BOXTAL_SHIPPER_COMPANY=
BOXTAL_SHIPPER_EMAIL=
BOXTAL_SHIPPER_PHONE=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- S3-compatible object storage (uploads + generated invoice PDFs) ---
S3_ENDPOINT=
# Laissé en commentaire volontairement : src/lib/server/s3.ts retombe déjà
# sur "eu-west-1" en dur dans le code si cette variable est absente
# (`process.env.S3_REGION || "eu-west-1"`) — pas besoin de la définir ici,
# ce qui évite au passage le souci de guillemets vécu en prod (voir la note
# tout en haut de ce fichier). Ne dé-commenter que pour une vraie région
# différente.
# S3_REGION=eu-west-1
S3_BUCKET=nasap3d
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
