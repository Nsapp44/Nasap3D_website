{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "public",
    "node_modules",
    "vendor",
    "server",
    "assets",
    "backups",
    "screenshots",
    "scripts",
    "uploads",
    "support.js",
    "*.dc.html",
    "*.js"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}